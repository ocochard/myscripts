 MODULE_VERSION(nfs, 1);
 
@@ -972,6 +972,14 @@ nfs_mount(struct mount *mp)
 	}
 
 	td = curthread;
+	/*
+	 * A jail without its own vnet would make its RPCs, and its gssd and
