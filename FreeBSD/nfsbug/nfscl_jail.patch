diff --git sys/nfs/nfs_nfssvc.c sys/nfs/nfs_nfssvc.c
index b49afeda5a31..2661ac00a7d0 100644
--- sys/nfs/nfs_nfssvc.c
+++ sys/nfs/nfs_nfssvc.c
@@ -82,8 +82,12 @@ sys_nfssvc(struct thread *td, struct nfssvc_args *uap)
 
