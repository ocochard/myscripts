From ede5032f6fb073e0656f58d98d92de453923e47b Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sun, 22 Nov 2026 12:51:54 +0100
Subject: [PATCH 1/2] x86: Release the IOMMU entries of an MSI group at once

msi_alloc() takes the interrupt remapping entries of a multiple-message
MSI group as one block, but msi_release() returned them one message at
a time.  The DMAR driver frees each with vmem_free(cookie, 1): the
extra messages, released first, do not start a vmem segment, so
releasing a group with interrupt remapping on fails an assertion or
dereferences a NULL segment.

Pass the whole group to iommu_unmap_msi_intr() with its count, and free
the block at once in the DMAR driver.  The AMD driver keeps clearing
each entry for now.

Fixes:		0a110d5b172e ("Use VT-d interrupt remapping block (IR) to perform FSB messages translation.")
MFC after:	1 week
---
 sys/x86/iommu/amd_intrmap.c   |  5 +++--
 sys/x86/iommu/amd_iommu.h     |  2 +-
 sys/x86/iommu/intel_dmar.h    |  2 +-
 sys/x86/iommu/intel_intrmap.c | 27 +++++++++++++++------------
 sys/x86/iommu/iommu_intrmap.h |  2 +-
 sys/x86/iommu/iommu_utils.c   |  6 +++---
 sys/x86/iommu/x86_iommu.h     |  2 +-
 sys/x86/x86/msi.c             | 19 ++++++++-----------
 8 files changed, 33 insertions(+), 32 deletions(-)

diff --git a/sys/x86/iommu/amd_intrmap.c b/sys/x86/iommu/amd_intrmap.c
index 3e48281d1931..585a5d84c3a2 100644
--- a/sys/x86/iommu/amd_intrmap.c
+++ b/sys/x86/iommu/amd_intrmap.c
@@ -192,14 +192,15 @@ amdiommu_map_msi_intr(device_t src, u_int cpu, u_int vector,
 }
 
 int
-amdiommu_unmap_msi_intr(device_t src, u_int cookie)
+amdiommu_unmap_msi_intr(device_t src, u_int cookie, u_int count)
 {
 	struct amdiommu_ctx *ctx;
 
 	if (cookie == -1)
 		return (0);
 	ctx = amdiommu_ir_find(src, NULL, NULL);
-	amdiommu_ir_free_irte(ctx, src, cookie);
+	for (u_int i = 0; i < count; i++)
+		amdiommu_ir_free_irte(ctx, src, cookie + i);
 	return (0);
 }
 
diff --git a/sys/x86/iommu/amd_iommu.h b/sys/x86/iommu/amd_iommu.h
index b9f07418ca9d..f138efb4b23e 100644
--- a/sys/x86/iommu/amd_iommu.h
+++ b/sys/x86/iommu/amd_iommu.h
@@ -199,7 +199,7 @@ void amdiommu_fini_event(struct amdiommu_unit *unit);
 int amdiommu_alloc_msi_intr(device_t src, u_int *cookies, u_int count);
 int amdiommu_map_msi_intr(device_t src, u_int cpu, u_int vector,
     u_int cookie, uint64_t *addr, uint32_t *data);
-int amdiommu_unmap_msi_intr(device_t src, u_int cookie);
+int amdiommu_unmap_msi_intr(device_t src, u_int cookie, u_int count);
 int amdiommu_map_ioapic_intr(u_int ioapic_id, u_int cpu, u_int vector,
     bool edge, bool activehi, int irq, u_int *cookie, uint32_t *hi,
     uint32_t *lo);
diff --git a/sys/x86/iommu/intel_dmar.h b/sys/x86/iommu/intel_dmar.h
index 018501082dd2..1a32506b8f47 100644
--- a/sys/x86/iommu/intel_dmar.h
+++ b/sys/x86/iommu/intel_dmar.h
@@ -258,7 +258,7 @@ void dmar_fini_irt(struct dmar_unit *unit);
 int dmar_alloc_msi_intr(device_t src, u_int *cookies, u_int count);
 int dmar_map_msi_intr(device_t src, u_int cpu, u_int vector, u_int cookie,
     uint64_t *addr, uint32_t *data);
-int dmar_unmap_msi_intr(device_t src, u_int cookie);
+int dmar_unmap_msi_intr(device_t src, u_int cookie, u_int count);
 int dmar_map_ioapic_intr(u_int ioapic_id, u_int cpu, u_int vector, bool edge,
     bool activehi, int irq, u_int *cookie, uint32_t *hi, uint32_t *lo);
 int dmar_unmap_ioapic_intr(u_int ioapic_id, u_int *cookie);
diff --git a/sys/x86/iommu/intel_intrmap.c b/sys/x86/iommu/intel_intrmap.c
index f12a0c9bae9b..4fef971231a1 100644
--- a/sys/x86/iommu/intel_intrmap.c
+++ b/sys/x86/iommu/intel_intrmap.c
@@ -63,7 +63,8 @@ static struct dmar_unit *dmar_ir_find(device_t src, uint16_t *rid,
     int *is_dmar);
 static void dmar_ir_program_irte(struct dmar_unit *unit, u_int idx,
     uint64_t low, uint16_t rid);
-static int dmar_ir_free_irte(struct dmar_unit *unit, u_int cookie);
+static int dmar_ir_free_irte(struct dmar_unit *unit, u_int cookie,
+    u_int count);
 
 int
 dmar_alloc_msi_intr(device_t src, u_int *cookies, u_int count)
@@ -140,14 +141,14 @@ dmar_map_msi_intr(device_t src, u_int cpu, u_int vector, u_int cookie,
 }
 
 int
-dmar_unmap_msi_intr(device_t src, u_int cookie)
+dmar_unmap_msi_intr(device_t src, u_int cookie, u_int count)
 {
 	struct dmar_unit *unit;
 
 	if (cookie == -1)
 		return (0);
 	unit = dmar_ir_find(src, NULL, NULL);
-	return (dmar_ir_free_irte(unit, cookie));
+	return (dmar_ir_free_irte(unit, cookie, count));
 }
 
 int
@@ -226,7 +227,7 @@ dmar_unmap_ioapic_intr(u_int ioapic_id, u_int *cookie)
 	unit = dmar_find_ioapic(ioapic_id, NULL);
 	KASSERT(unit != NULL && unit->ir_enabled,
 	    ("unmap: cookie %d unit %p", idx, unit));
-	return (dmar_ir_free_irte(unit, idx));
+	return (dmar_ir_free_irte(unit, idx, 1));
 }
 
 static struct dmar_unit *
@@ -302,21 +303,23 @@ dmar_ir_program_irte(struct dmar_unit *unit, u_int idx, uint64_t low,
 }
 
 static int
-dmar_ir_free_irte(struct dmar_unit *unit, u_int cookie)
+dmar_ir_free_irte(struct dmar_unit *unit, u_int cookie, u_int count)
 {
 	dmar_irte_t *irte;
 
 	KASSERT(unit != NULL && unit->ir_enabled,
 	    ("unmap: cookie %d unit %p", cookie, unit));
-	KASSERT(cookie < unit->irte_cnt,
-	    ("bad cookie %u %u", cookie, unit->irte_cnt));
-	irte = &(unit->irt[cookie]);
-	dmar_pte_clear(&irte->irte1);
-	dmar_pte_clear(&irte->irte2);
+	KASSERT(cookie < unit->irte_cnt && count <= unit->irte_cnt - cookie,
+	    ("bad cookie %u count %u %u", cookie, count, unit->irte_cnt));
+	for (u_int i = 0; i < count; i++) {
+		irte = &(unit->irt[cookie + i]);
+		dmar_pte_clear(&irte->irte1);
+		dmar_pte_clear(&irte->irte2);
+	}
 	DMAR_LOCK(unit);
-	dmar_qi_invalidate_iec(unit, cookie, 1);
+	dmar_qi_invalidate_iec(unit, cookie, count);
 	DMAR_UNLOCK(unit);
-	vmem_free(unit->irtids, cookie, 1);
+	vmem_free(unit->irtids, cookie, count);
 	return (0);
 }
 
diff --git a/sys/x86/iommu/iommu_intrmap.h b/sys/x86/iommu/iommu_intrmap.h
index 59e6317f7e15..7fbc854f1e93 100644
--- a/sys/x86/iommu/iommu_intrmap.h
+++ b/sys/x86/iommu/iommu_intrmap.h
@@ -32,7 +32,7 @@
 int iommu_alloc_msi_intr(device_t src, u_int *cookies, u_int count);
 int iommu_map_msi_intr(device_t src, u_int cpu, u_int vector, u_int cookie,
     uint64_t *addr, uint32_t *data);
-int iommu_unmap_msi_intr(device_t src, u_int cookie);
+int iommu_unmap_msi_intr(device_t src, u_int cookie, u_int count);
 int iommu_map_ioapic_intr(u_int ioapic_id, u_int cpu, u_int vector, bool edge,
     bool activehi, int irq, u_int *cookie, uint32_t *hi, uint32_t *lo);
 int iommu_unmap_ioapic_intr(u_int ioapic_id, u_int *cookie);
diff --git a/sys/x86/iommu/iommu_utils.c b/sys/x86/iommu/iommu_utils.c
index d2ff9a985968..d984d6970d9d 100644
--- a/sys/x86/iommu/iommu_utils.c
+++ b/sys/x86/iommu/iommu_utils.c
@@ -218,7 +218,7 @@ x86_no_iommu_map_msi_intr(device_t src, u_int cpu, u_int vector,
 }
 
 static int
-x86_no_iommu_unmap_msi_intr(device_t src, u_int cookie)
+x86_no_iommu_unmap_msi_intr(device_t src, u_int cookie, u_int count)
 {
 	return (0);
 }
@@ -309,9 +309,9 @@ iommu_map_msi_intr(device_t src, u_int cpu, u_int vector, u_int cookie,
 }
 
 int
-iommu_unmap_msi_intr(device_t src, u_int cookie)
+iommu_unmap_msi_intr(device_t src, u_int cookie, u_int count)
 {
-	return (x86_iommu->unmap_msi_intr(src, cookie));
+	return (x86_iommu->unmap_msi_intr(src, cookie, count));
 }
 
 int
diff --git a/sys/x86/iommu/x86_iommu.h b/sys/x86/iommu/x86_iommu.h
index 431228512fd8..18a98893610a 100644
--- a/sys/x86/iommu/x86_iommu.h
+++ b/sys/x86/iommu/x86_iommu.h
@@ -85,7 +85,7 @@ struct x86_iommu {
 	int (*alloc_msi_intr)(device_t src, u_int *cookies, u_int count);
 	int (*map_msi_intr)(device_t src, u_int cpu, u_int vector,
 	    u_int cookie, uint64_t *addr, uint32_t *data);
-	int (*unmap_msi_intr)(device_t src, u_int cookie);
+	int (*unmap_msi_intr)(device_t src, u_int cookie, u_int count);
 	int (*map_ioapic_intr)(u_int ioapic_id, u_int cpu, u_int vector,
 	    bool edge, bool activehi, int irq, u_int *cookie, uint32_t *hi,
 	    uint32_t *lo);
diff --git a/sys/x86/x86/msi.c b/sys/x86/x86/msi.c
index 9d5409015de7..03b3dc5bac32 100644
--- a/sys/x86/x86/msi.c
+++ b/sys/x86/x86/msi.c
@@ -561,16 +561,18 @@ msi_release(int *irqs, int count)
 	}
 	KASSERT(first->msi_dev != NULL, ("unowned group"));
 
+#ifdef IOMMU
+	/* The remapping entries of the group were allocated as one block. */
+	mtx_unlock(&msi_lock);
+	iommu_unmap_msi_intr(first->msi_dev, first->msi_remap_cookie, count);
+	mtx_lock(&msi_lock);
+#endif
+
 	/* Clear all the extra messages in the group. */
 	for (i = 1; i < count; i++) {
 		msi = (struct msi_intsrc *)intr_lookup_source(irqs[i]);
 		KASSERT(msi->msi_first == first, ("message not in group"));
 		KASSERT(msi->msi_dev == first->msi_dev, ("owner mismatch"));
-#ifdef IOMMU
-		mtx_unlock(&msi_lock);
-		iommu_unmap_msi_intr(first->msi_dev, msi->msi_remap_cookie);
-		mtx_lock(&msi_lock);
-#endif
 		msi->msi_first = NULL;
 		msi->msi_dev = NULL;
 		apic_free_vector(msi->msi_cpu, msi->msi_vector, msi->msi_irq);
@@ -578,11 +580,6 @@ msi_release(int *irqs, int count)
 	}
 
 	/* Clear out the first message. */
-#ifdef IOMMU
-	mtx_unlock(&msi_lock);
-	iommu_unmap_msi_intr(first->msi_dev, first->msi_remap_cookie);
-	mtx_lock(&msi_lock);
-#endif
 	first->msi_first = NULL;
 	first->msi_dev = NULL;
 	apic_free_vector(first->msi_cpu, first->msi_vector, first->msi_irq);
@@ -787,7 +784,7 @@ msix_release(int irq)
 	/* Clear out the message. */
 #ifdef IOMMU
 	mtx_unlock(&msi_lock);
-	iommu_unmap_msi_intr(msi->msi_dev, msi->msi_remap_cookie);
+	iommu_unmap_msi_intr(msi->msi_dev, msi->msi_remap_cookie, 1);
 	mtx_lock(&msi_lock);
 #endif
 	msi->msi_first = NULL;
-- 
