From 27c94c177c17994cc8e12815fb2025f84a57c372 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sun, 22 Nov 2026 12:52:38 +0100
Subject: [PATCH 2/2] amdiommu: Free and align interrupt remapping entries

amdiommu_ir_free_irte() cleared the IRTE but never returned its index,
so a device's 32 default entries run out: a driver using 32 MSI-X
vectors gets ENOMEM from pci_alloc_msix() on its second attach.  Free
the block with vmem_xfree(), now that msi_release() hands a group over
whole, and allocate it with vmem_xalloc() aligned on its size, since
the device ORs the message number into the MSI data, which is the IRTE
index.

Fixes:		0f5116d7efe3 ("AMD IOMMU driver")
MFC after:	1 week
---
 sys/x86/iommu/amd_intrmap.c | 49 ++++++++++++++++++++++---------------
 1 file changed, 29 insertions(+), 20 deletions(-)

diff --git a/sys/x86/iommu/amd_intrmap.c b/sys/x86/iommu/amd_intrmap.c
index 585a5d84c3a2..b410b36b6a7c 100644
--- a/sys/x86/iommu/amd_intrmap.c
+++ b/sys/x86/iommu/amd_intrmap.c
@@ -76,7 +76,7 @@
 static struct amdiommu_ctx *amdiommu_ir_find(device_t src, uint16_t *rid,
     bool *is_iommu);
 static void amdiommu_ir_free_irte(struct amdiommu_ctx *ctx, device_t src,
-    u_int cookie);
+    u_int cookie, u_int count);
 
 int
 amdiommu_alloc_msi_intr(device_t src, u_int *cookies, u_int count)
@@ -93,8 +93,13 @@ amdiommu_alloc_msi_intr(device_t src, u_int *cookies, u_int count)
 		return (EOPNOTSUPP);
 	}
 
-	error = vmem_alloc(ctx->irtids, count, M_FIRSTFIT | M_NOWAIT,
-	    &vmem_res);
+	/*
+	 * The MSI data is the entry index, and a multiple-message device
+	 * ORs the message number into it: align the block on its size.
+	 */
+	KASSERT(powerof2(count), ("MSI count %u", count));
+	error = vmem_xalloc(ctx->irtids, count, count, 0, 0, VMEM_ADDR_MIN,
+	    VMEM_ADDR_MAX, M_FIRSTFIT | M_NOWAIT, &vmem_res);
 	if (error != 0) {
 		KASSERT(error != EOPNOTSUPP,
 		    ("impossible EOPNOTSUPP from vmem"));
@@ -199,8 +204,8 @@ amdiommu_unmap_msi_intr(device_t src, u_int cookie, u_int count)
 	if (cookie == -1)
 		return (0);
 	ctx = amdiommu_ir_find(src, NULL, NULL);
-	for (u_int i = 0; i < count; i++)
-		amdiommu_ir_free_irte(ctx, src, cookie + i);
+	amdiommu_ir_free_irte(ctx, src, cookie, count);
+	vmem_xfree(ctx->irtids, cookie, count);
 	return (0);
 }
 
@@ -268,7 +273,7 @@ amdiommu_ir_find(device_t src, uint16_t *ridp, bool *is_iommu)
 
 static void
 amdiommu_ir_free_irte(struct amdiommu_ctx *ctx, device_t src,
-    u_int cookie)
+    u_int cookie, u_int count)
 {
 	struct amdiommu_unit *unit;
 	device_t requester;
@@ -280,24 +285,28 @@ amdiommu_ir_free_irte(struct amdiommu_ctx *ctx, device_t src,
 
 	KASSERT(unit->irte_enabled,
 	    ("unmap: cookie %d ctx %p unit %p", cookie, ctx, unit));
-	KASSERT(cookie < unit->irte_nentries,
-	    ("bad cookie %u %u", cookie, unit->irte_nentries));
+	KASSERT(cookie < unit->irte_nentries &&
+	    count <= unit->irte_nentries - cookie,
+	    ("bad cookie %u count %u %u", cookie, count, unit->irte_nentries));
 
-	if (unit->irte_x2apic) {
-		struct amdiommu_irte_basic_vapic_x2 *irte;
+	for (u_int i = cookie; i < cookie + count; i++) {
+		if (unit->irte_x2apic) {
+			struct amdiommu_irte_basic_vapic_x2 *irte;
 
-		irte = &ctx->irtx2[cookie];
-		irte->remapen = 0;
-		atomic_thread_fence_rel();
-		bzero(irte, sizeof(*irte));
-	} else {
-		struct amdiommu_irte_basic_novapic *irte;
+			irte = &ctx->irtx2[i];
+			irte->remapen = 0;
+			atomic_thread_fence_rel();
+			bzero(irte, sizeof(*irte));
+		} else {
+			struct amdiommu_irte_basic_novapic *irte;
 
-		irte = &ctx->irtb[cookie];
-		irte->remapen = 0;
-		atomic_thread_fence_rel();
-		bzero(irte, sizeof(*irte));
+			irte = &ctx->irtb[i];
+			irte->remapen = 0;
+			atomic_thread_fence_rel();
+			bzero(irte, sizeof(*irte));
+		}
 	}
+	/* One invalidation covers the whole table of the device. */
 	error = iommu_get_requester(src, &requester, &rid);
 	MPASS(error == 0);
 	AMDIOMMU_LOCK(unit);
-- 
2.56.0

