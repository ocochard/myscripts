From dd75503aa8cfaf58d704e3d8daabbbcca70ab19b Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sun, 15 Nov 2026 13:35:15 +0000
Subject: [PATCH] pci: Accept D3hot in pci_set_powerstate_method()

Since D3 was split into D3hot (3) and D3cold (4), PCI_POWERSTATE_D3 is
D3cold and the switch rejects D3hot with EINVAL.  An _SxD of 3 is D3hot,
so on suspend such devices silently stay in D0; acpi_pci also skips
their ACPI transition.  The HP ZBook Ultra G1a GPU (GFX0 _S3D = 3) is
one, and LinuxKPI pci_set_power_state(PCI_D3hot) has the same problem.

The PM register has a single D3 state, so write it for both.

Fixes:		84bbfc32a3f4 ("acpi_powerres: D3cold support")
MFC after:	1 week
---
 sys/dev/pci/pci.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/sys/dev/pci/pci.c b/sys/dev/pci/pci.c
index 35f8e1154d6c..3d78cde34604 100644
--- a/sys/dev/pci/pci.c
+++ b/sys/dev/pci/pci.c
@@ -2891,10 +2891,12 @@ pci_set_powerstate_method(device_t dev, device_t child, int state)
 	/*
 	 * Optimize a no state change request away.  While it would be OK to
 	 * write to the hardware in theory, some devices have shown odd
-	 * behavior when going from D3 -> D3.
+	 * behavior when going from D3 -> D3.  D3hot and D3cold are the same
+	 * state in the PM register.
 	 */
 	oldstate = pci_get_powerstate(child);
-	if (oldstate == state)
+	if (oldstate == state || (oldstate >= PCI_POWERSTATE_D3_HOT &&
+	    state >= PCI_POWERSTATE_D3_HOT))
 		return (0);
 
 	/*
@@ -2910,7 +2912,7 @@ pci_set_powerstate_method(device_t dev, device_t child, int state)
 	 * this function can be called from contexts where we cannot sleep.
 	 */
 	highest = (oldstate > state) ? oldstate : state;
-	if (highest == PCI_POWERSTATE_D3)
+	if (highest >= PCI_POWERSTATE_D3_HOT)
 	    delay = 10000;
 	else if (highest == PCI_POWERSTATE_D2)
 	    delay = 200;
@@ -2932,7 +2934,8 @@ pci_set_powerstate_method(device_t dev, device_t child, int state)
 			return (EOPNOTSUPP);
 		status |= PCIM_PSTAT_D2;
 		break;
-	case PCI_POWERSTATE_D3:
+	case PCI_POWERSTATE_D3_HOT:
+	case PCI_POWERSTATE_D3_COLD:
 		status |= PCIM_PSTAT_D3;
 		break;
 	default:
-- 
