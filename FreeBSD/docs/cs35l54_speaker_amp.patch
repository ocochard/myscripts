index 4a39645fcba3..f26e05537f53 100644
--- a/share/man/man4/Makefile
+++ b/share/man/man4/Makefile
@@ -570,6 +570,7 @@ MAN=	aac.4 \
 	snd_als4000.4 \
 	snd_atiixp.4 \
 	snd_cmi.4 \
+	${_snd_cs35l54.4} \
 	snd_cs4281.4 \
 	snd_csa.4 \
 	snd_dummy.4 \
@@ -967,6 +968,7 @@ _qlxgbe.4=	qlxgbe.4
 _qlnxe.4=	qlnxe.4
 _sfxge.4=	sfxge.4
 _smartpqi.4=	smartpqi.4
+_snd_cs35l54.4=	snd_cs35l54.4
 _sume.4=	sume.4
 
 MLINKS+=iwx.4 if_iwx.4
