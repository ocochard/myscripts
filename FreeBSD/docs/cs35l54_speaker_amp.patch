From 8d7d367dde1add001c90c8d861d0286b5bf9e55e Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Wed, 11 Nov 2026 15:04:26 +0000
Subject: [PATCH 1/2] snd_hda: Add an event for internal speaker stream start
 and stop

Some laptops put smart amplifiers between the HDA codec and the
speakers.  Those amplifiers sit on another bus (I2C here) and stay
silent until their driver tells them to play, so their driver must
know when the codec starts and stops a stream to the internal speaker.

Fire an hdaa_speaker event, outside the hdaa lock, when a playback
channel whose association contains a fixed internal speaker pin starts
or stops.  The event carries the codec subsystem id so the amplifier
driver can match its own platform.
---
 sys/dev/sound/pci/hda/hdaa.c         | 35 ++++++++++++++++++++++++++++
 sys/dev/sound/pci/hda/hdaa_speaker.h | 22 +++++++++++++++++
 2 files changed, 57 insertions(+)
 create mode 100644 sys/dev/sound/pci/hda/hdaa_speaker.h

diff --git a/sys/dev/sound/pci/hda/hdaa.c b/sys/dev/sound/pci/hda/hdaa.c
index b91864d45dba..1504b44aafe2 100644
--- a/sys/dev/sound/pci/hda/hdaa.c
+++ b/sys/dev/sound/pci/hda/hdaa.c
@@ -44,6 +44,7 @@
 #include <dev/sound/pci/hda/hdac.h>
 #include <dev/sound/pci/hda/hdaa.h>
 #include <dev/sound/pci/hda/hda_reg.h>
+#include <dev/sound/pci/hda/hdaa_speaker.h>
 
 #include "mixer_if.h"
 
@@ -2219,10 +2220,38 @@ hdaa_channel_start(struct hdaa_chan *ch)
 	return (0);
 }
 
+/*
+ * True if the association drives a fixed internal speaker, which may sit
+ * behind external amplifiers that must follow the stream.
+ */
+static bool
+hdaa_as_has_speaker(struct hdaa_devinfo *devinfo, struct hdaa_audio_as *as)
+{
+	struct hdaa_widget *w;
+	uint32_t conf;
+
+	for (int i = 0; i < 16; i++) {
+		if (as->pins[i] <= 0)
+			continue;
+		w = hdaa_widget_get(devinfo, as->pins[i]);
+		if (w == NULL ||
+		    w->type != HDA_PARAM_AUDIO_WIDGET_CAP_TYPE_PIN_COMPLEX)
+			continue;
+		conf = w->wclass.pin.config;
+		if ((conf & HDA_CONFIG_DEFAULTCONF_DEVICE_MASK) ==
+		    HDA_CONFIG_DEFAULTCONF_DEVICE_SPEAKER &&
+		    (conf & HDA_CONFIG_DEFAULTCONF_CONNECTIVITY_MASK) ==
+		    HDA_CONFIG_DEFAULTCONF_CONNECTIVITY_FIXED)
+			return (true);
+	}
+	return (false);
+}
+
 static int
 hdaa_channel_trigger(kobj_t obj, void *data, int go)
 {
 	struct hdaa_chan *ch = data;
+	bool speaker;
 	int error = 0;
 
 	if (!PCMTRIG_COMMON(go))
@@ -2240,7 +2269,13 @@ hdaa_channel_trigger(kobj_t obj, void *data, int go)
 	default:
 		break;
 	}
+	speaker = error == 0 && ch->dir == PCMDIR_PLAY &&
+	    hdaa_as_has_speaker(ch->devinfo, &ch->devinfo->as[ch->as]);
 	hdaa_unlock(ch->devinfo);
+	if (speaker)
+		EVENTHANDLER_INVOKE(hdaa_speaker, ch->devinfo->dev,
+		    hda_get_subsystem_id(ch->devinfo->dev),
+		    go == PCMTRIG_START);
 
 	return (error);
 }
diff --git a/sys/dev/sound/pci/hda/hdaa_speaker.h b/sys/dev/sound/pci/hda/hdaa_speaker.h
new file mode 100644
index 000000000000..078024edeb7e
--- /dev/null
+++ b/sys/dev/sound/pci/hda/hdaa_speaker.h
@@ -0,0 +1,22 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 Olivier Cochard <olivier@FreeBSD.org>
+ */
+
+#ifndef _HDAA_SPEAKER_H_
+#define	_HDAA_SPEAKER_H_
+
+#include <sys/eventhandler.h>
+
+/*
+ * Fired by hdaa(4) when a playback stream to a fixed internal speaker pin
+ * starts or stops, outside of any hdaa lock.  Drivers of external speaker
+ * amplifiers (side codecs) match the codec subsystem id and must not sleep
+ * in the handler.
+ */
+typedef void (*hdaa_speaker_fn)(void *arg, device_t hdaa, uint32_t subsystem,
+    bool active);
+EVENTHANDLER_DECLARE(hdaa_speaker, hdaa_speaker_fn);
+
+#endif /* _HDAA_SPEAKER_H_ */
-- 
2.56.0


From a2f3c42ec4cc6d6b487558a3577de703d23e6fd6 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sun, 22 Nov 2026 12:15:22 +0100
Subject: [PATCH 2/2] sound: Add snd_cs35l54 for HDA side speaker amplifiers

The internal speakers of the HP ZBook Ultra G1a are driven by four
Cirrus Logic CS35L54 smart amplifiers (ACPI CSC3554) on an I2C bus,
behind the Realtek HDA codec.  They boot a ROM firmware that renders no
audio, so the speakers stayed silent.

snd_cs35l54 downloads the DSP program and the per-amplifier tuning
through firmware(9), as module images or raw files, deferring to
mountroot when attached early, and applies the factory calibration
from UEFI.  It starts and pauses the amplifiers with the internal
speaker stream of hdaa(4), keeping them ready for a few seconds between
streams, and handles suspend and resume.  devmatch(8) loads it.  It is
built on amd64 only, as it uses the EFI runtime services.
---
 share/man/man4/Makefile                   |    2 +
 share/man/man4/snd_cs35l54.4              |  155 +++
 sys/dev/sound/pci/hda/cs35l54.c           | 1309 +++++++++++++++++++++
 sys/modules/sound/driver/Makefile         |    4 +
 sys/modules/sound/driver/cs35l54/Makefile |    8 +
 5 files changed, 1478 insertions(+)
 create mode 100644 share/man/man4/snd_cs35l54.4
 create mode 100644 sys/dev/sound/pci/hda/cs35l54.c
 create mode 100644 sys/modules/sound/driver/cs35l54/Makefile

