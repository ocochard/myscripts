From 4d3d79812920f8717288547dddd9b5caa6e17915 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sat, 21 Nov 2026 23:39:23 +0100
Subject: [PATCH] devmatch: Match hostb(4) devices

amdtemp(4), amdsmn(4) and amdsmu(4) attach below hostb(4), which owns
the host bridge.  devmatch skipped this attached device, so the modules
never autoloaded.

Match a device owned by hostb(4) against the hints for hostb as a bus,
and move the tables of amdtemp(4), amdsmn(4) and amdsmu(4) there, so
only drivers that attach below hostb(4) match.  devmatch -a still
reports the matches on the parent bus.  amdsmu(4) now loads at boot on
the AMD laptops it supports, where it sends the SMU sleep hint on
suspend-to-idle.

Reviewed by:	imp, wulf
Pull Request:	https://ron-dev.freebsd.org/FreeBSD/src/pulls/123
---
 sbin/devmatch/devmatch.c  | 30 ++++++++++++++++++++++++------
 sys/dev/amdsmn/amdsmn.c   |  2 +-
 sys/dev/amdsmu/amdsmu.c   |  2 +-
 sys/dev/amdtemp/amdtemp.c |  2 +-
 4 files changed, 27 insertions(+), 9 deletions(-)

diff --git a/sbin/devmatch/devmatch.c b/sbin/devmatch/devmatch.c
index baf52c070b70..42f400488317 100644
--- a/sbin/devmatch/devmatch.c
+++ b/sbin/devmatch/devmatch.c
@@ -473,18 +473,35 @@ search_hints(const char *bus, const char *dev, const char *pnpinfo)
 	free(lastmod);
 }
 
+static void
+search_bus(struct devinfo_dev *dev, const char *bus)
+{
+	if (verbose_flag)
+		printf("Searching %s %s bus at %s for pnpinfo %s\n",
+		    dev->dd_name, bus, dev->dd_location, dev->dd_pnpinfo);
+	search_hints(bus, dev->dd_name, dev->dd_pnpinfo);
+}
+
 static int
 find_unmatched(struct devinfo_dev *dev, void *arg)
 {
 	struct devinfo_dev *parent;
 	char *bus, *p;
+	bool busdrv;
 
+	/*
+	 * hostb(4) attaches to host bridges only to be the bus of the drivers
+	 * for their functions, such as amdtemp(4), which add their own child
+	 * once their module is loaded.  Match a hostb device as if it had no
+	 * driver, against the hints for that bus, so those modules load.
+	 */
+	busdrv = !unbound_flag && strcmp(dev->dd_drivername, "hostb") == 0;
 	do {
-		if (!all_flag && dev->dd_name[0] != '\0')
+		if (!all_flag && !busdrv && dev->dd_name[0] != '\0')
 			break;
 		if (!(dev->dd_flags & DF_ENABLED))
 			break;
-		if (!all_flag && dev->dd_flags & DF_ATTACHED_ONCE)
+		if (!all_flag && !busdrv && dev->dd_flags & DF_ATTACHED_ONCE)
 			break;
 		parent = devinfo_handle_to_device(dev->dd_parent);
 		bus = strdup(parent->dd_name);
@@ -492,10 +509,11 @@ find_unmatched(struct devinfo_dev *dev, void *arg)
 		while (p >= bus && isdigit(*p))
 			p--;
 		*++p = '\0';
-		if (verbose_flag)
-			printf("Searching %s %s bus at %s for pnpinfo %s\n",
-			    dev->dd_name, bus, dev->dd_location, dev->dd_pnpinfo);
-		search_hints(bus, dev->dd_name, dev->dd_pnpinfo);
+		/* -a still reports the matches on the parent bus. */
+		if (!busdrv || all_flag)
+			search_bus(dev, bus);
+		if (busdrv)
+			search_bus(dev, dev->dd_drivername);
 		free(bus);
 	} while (0);
 
diff --git a/sys/dev/amdsmn/amdsmn.c b/sys/dev/amdsmn/amdsmn.c
index d19103738ec6..dd81269ba032 100644
--- a/sys/dev/amdsmn/amdsmn.c
+++ b/sys/dev/amdsmn/amdsmn.c
@@ -178,7 +178,7 @@ static driver_t amdsmn_driver = {
 
 DRIVER_MODULE(amdsmn, hostb, amdsmn_driver, NULL, NULL);
 MODULE_VERSION(amdsmn, 1);
-MODULE_PNP_INFO("U16:vendor;U16:device", pci, amdsmn, amdsmn_ids,
+MODULE_PNP_INFO("U16:vendor;U16:device", hostb, amdsmn, amdsmn_ids,
     nitems(amdsmn_ids));
 
 static bool
diff --git a/sys/dev/amdsmu/amdsmu.c b/sys/dev/amdsmu/amdsmu.c
index 4d833e90cf11..ecb3f495d8fe 100644
--- a/sys/dev/amdsmu/amdsmu.c
+++ b/sys/dev/amdsmu/amdsmu.c
@@ -592,5 +592,5 @@ static driver_t amdsmu_driver = {
 DRIVER_MODULE(amdsmu, hostb, amdsmu_driver, NULL, NULL);
 MODULE_VERSION(amdsmu, 1);
 MODULE_DEPEND(amdsmu, amdsmn, 1, 1, 1);
-MODULE_PNP_INFO("U16:vendor;U16:device", pci, amdsmu, amdsmu_products,
+MODULE_PNP_INFO("U16:vendor;U16:device", hostb, amdsmu, amdsmu_products,
     nitems(amdsmu_products));
diff --git a/sys/dev/amdtemp/amdtemp.c b/sys/dev/amdtemp/amdtemp.c
index b1ecb014a2b0..3b9938cdee5a 100644
--- a/sys/dev/amdtemp/amdtemp.c
+++ b/sys/dev/amdtemp/amdtemp.c
@@ -258,7 +258,7 @@ static driver_t amdtemp_driver = {
 DRIVER_MODULE(amdtemp, hostb, amdtemp_driver, NULL, NULL);
 MODULE_VERSION(amdtemp, 1);
 MODULE_DEPEND(amdtemp, amdsmn, 1, 1, 1);
-MODULE_PNP_INFO("U16:vendor;U16:device", pci, amdtemp, amdtemp_products,
+MODULE_PNP_INFO("U16:vendor;U16:device", hostb, amdtemp, amdtemp_products,
     nitems(amdtemp_products));
 
 static bool
-- 
