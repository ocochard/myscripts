From ba7367828c2bc1337c42b56cb2fe11c1ab5c3a21 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sat, 21 Nov 2026 21:48:18 +0100
Subject: [PATCH 1/2] linuxkpi: Give each srcu_struct its own grace period

srcu_read_lock() and synchronize_srcu() ignored their srcu_struct and
shared one sleepable epoch, so synchronize_srcu() inside any SRCU read
section waited for itself.  drm-kmod runs every ioctl inside
drm_dev_enter(), an SRCU read section, and the amdxdna driver being
ported from Linux (AMD XDNA NPU) destroys a hardware context with
synchronize_srcu() from such an ioctl: the ioctl spins forever in
ck_epoch_synchronize_wait().

Count readers per srcu_struct in two phases.  synchronize_srcu() flips
the phase, fences every CPU with cpus_fence_seq_cst(), uses
quiesce_all_critical() to wait for readers that sampled the old phase
but have not counted themselves yet, then waits for the old phase to
drain.  A zeroed srcu_struct stays valid, so DEFINE_STATIC_SRCU() is
unchanged.

struct srcu_struct grows from 0 to 16 bytes: modules that embed or
declare one (drm-kmod, ib_uverbs, mlx5_ib) must be rebuilt.
---
 .../linuxkpi/common/include/linux/srcu.h      | 10 ++++
 sys/compat/linuxkpi/common/src/linux_rcu.c    | 56 +++++++++++++++++--
 2 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/sys/compat/linuxkpi/common/include/linux/srcu.h b/sys/compat/linuxkpi/common/include/linux/srcu.h
index b42c28a1311b..680b59cd642d 100644
--- a/sys/compat/linuxkpi/common/include/linux/srcu.h
+++ b/sys/compat/linuxkpi/common/include/linux/srcu.h
@@ -28,8 +28,18 @@
 #define	_LINUXKPI_LINUX_SRCU_H_
 
 #include <linux/compiler.h>
+#include <linux/types.h>
 
+/*
+ * Each srcu_struct is its own grace period domain: readers count
+ * themselves in the counter of the current phase, and
+ * synchronize_srcu() flips the phase and waits for the old counter to
+ * drain.  A zeroed structure is ready for use.
+ */
 struct srcu_struct {
+	volatile u_int	ss_phase;	/* low bit selects ss_readers[] */
+	volatile u_int	ss_readers[2];
+	volatile u_int	ss_writer;	/* serializes synchronize_srcu() */
 };
 
 #define	srcu_dereference(p, srcu) \
diff --git a/sys/compat/linuxkpi/common/src/linux_rcu.c b/sys/compat/linuxkpi/common/src/linux_rcu.c
index c0b864d269b3..dd7ffb04ba36 100644
--- a/sys/compat/linuxkpi/common/src/linux_rcu.c
+++ b/sys/compat/linuxkpi/common/src/linux_rcu.c
@@ -427,31 +427,77 @@ linux_call_rcu(unsigned type, struct rcu_head *context, rcu_callback_t func)
 int
 init_srcu_struct(struct srcu_struct *srcu)
 {
+	memset(srcu, 0, sizeof(*srcu));
 	return (0);
 }
 
 void
 cleanup_srcu_struct(struct srcu_struct *srcu)
 {
+	MPASS(srcu->ss_readers[0] == 0 && srcu->ss_readers[1] == 0);
 }
 
 int
 srcu_read_lock(struct srcu_struct *srcu)
 {
-	linux_rcu_read_lock(RCU_TYPE_SLEEPABLE);
-	return (0);
+	int idx;
+
+	if (RCU_SKIP())
+		return (0);
+
+	/*
+	 * No preemption between sampling the phase and counting the
+	 * reader: synchronize_srcu() relies on quiesce_all_critical() to
+	 * see every reader that sampled the old phase.
+	 */
+	critical_enter();
+	idx = atomic_load_acq_int(&srcu->ss_phase) & 1;
+	atomic_add_acq_int(&srcu->ss_readers[idx], 1);
+	/* Count before quiesce_all_critical() can see us leave. */
+	atomic_thread_fence_rel();
+	critical_exit();
+	return (idx);
 }
 
 void
-srcu_read_unlock(struct srcu_struct *srcu, int key __unused)
+srcu_read_unlock(struct srcu_struct *srcu, int idx)
 {
-	linux_rcu_read_unlock(RCU_TYPE_SLEEPABLE);
+	if (RCU_SKIP())
+		return;
+
+	atomic_subtract_rel_int(&srcu->ss_readers[idx], 1);
 }
 
 void
 synchronize_srcu(struct srcu_struct *srcu)
 {
-	linux_synchronize_rcu(RCU_TYPE_SLEEPABLE);
+	int idx;
+
+	if (RCU_SKIP())
+		return;
+
+	WITNESS_WARN(WARN_GIANTOK | WARN_SLEEPOK, NULL,
+	    "synchronize_srcu() can sleep");
+
+	while (atomic_cmpset_acq_int(&srcu->ss_writer, 0, 1) == 0)
+		pause("lsrcuw", 1);
+
+	/* Readers from now on count in the other phase. */
+	atomic_thread_fence_seq_cst();
+	idx = atomic_fetchadd_int(&srcu->ss_phase, 1) & 1;
+	/*
+	 * Flush every CPU so that a reader that sampled the old phase
+	 * shows up in its critical section, or else sees the new phase.
+	 */
+	cpus_fence_seq_cst();
+	quiesce_all_critical();
+	/* Read the counters after the td_critnest loads. */
+	atomic_thread_fence_acq();
+	while (atomic_load_acq_int(&srcu->ss_readers[idx]) != 0)
+		pause("lsrcu", 1);
+	atomic_thread_fence_seq_cst();
+
+	atomic_store_rel_int(&srcu->ss_writer, 0);
 }
 
 void
-- 
2.56.0


From 0c2e08cc4e7d7c7c1d981ca87d2631c5b122ccfd Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sat, 21 Nov 2026 21:48:18 +0100
Subject: [PATCH 2/2] UPDATING: bump __FreeBSD_version to 1600032 for LinuxKPI
 srcu_struct

struct srcu_struct grew from 0 to 16 bytes.  Allow modules that embed
or declare one to be rebuilt by bumping __FreeBSD_version.
---
 UPDATING        | 5 +++++
 sys/sys/param.h | 2 +-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/UPDATING b/UPDATING
index 56904191e819..f5cf4791c704 100644
--- a/UPDATING
+++ b/UPDATING
@@ -27,6 +27,11 @@ NOTE TO PEOPLE WHO THINK THAT FreeBSD 16.x IS SLOW:
 	world, or to merely disable the most expensive debugging functionality
 	at runtime, run "ln -s 'abort:false,junk:false' /etc/malloc.conf".)
 
+20261121:
+	struct srcu_struct in LinuxKPI grew from 0 to 16 bytes.  Modules
+	that embed or declare one, such as drm-kmod's, must be rebuilt.
+	Bump __FreeBSD_version to 1600032 to allow this change to be detected.
+
 20261113:
 	pwd_mkdb(8) now validates login names using the same character rules
 	that pw(8) applies, so names containing shell metacharacters or other
diff --git a/sys/sys/param.h b/sys/sys/param.h
index 04fe7b87bb0f..467581018cd0 100644
--- a/sys/sys/param.h
+++ b/sys/sys/param.h
@@ -74,7 +74,7 @@
  * cannot include sys/param.h and should only be updated here.
  */
 #undef __FreeBSD_version
-#define __FreeBSD_version 1600031
+#define __FreeBSD_version 1600032
 
 /*
  * __FreeBSD_kernel__ indicates that this system uses the kernel of FreeBSD,
-- 
