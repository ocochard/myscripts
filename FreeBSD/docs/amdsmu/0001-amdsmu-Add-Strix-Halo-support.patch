From ef5cf02d0c687e29dc9751c0f944d990ab864052 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Olivier=20Cochard-Labb=C3=A9?= <olivier@cochard.me>
Date: Thu, 12 Nov 2026 22:51:24 +0000
Subject: [PATCH] amdsmu: Add Strix Halo support

Strix Halo (family 1Ah model 70h) has root complex 0x1507 and the same
SMU interface as Krackan Point model 70h, as in Linux amd_pmc.
---
 sys/dev/amdsmu/amdsmu.h     | 3 +++
 sys/dev/amdsmu/amdsmu_reg.h | 1 +
 2 files changed, 4 insertions(+)

diff --git a/sys/dev/amdsmu/amdsmu.h b/sys/dev/amdsmu/amdsmu.h
index 5cfa8d19ccdb..e19e9fe6fa1c 100644
--- a/sys/dev/amdsmu/amdsmu.h
+++ b/sys/dev/amdsmu/amdsmu.h
@@ -113,6 +113,9 @@ static const struct amdsmu_product {
 	{ CPU_VENDOR_AMD,	PCI_DEVICEID_AMD_KRACKAN_POINT_ROOT,	0x70,
 	    SMU_REG_IDLEMASK_KRACKAN,	25,	amdsmu_ip_blocks_names_v2,
 	    SMU_REG_MSG_KRACKAN },
+	{ CPU_VENDOR_AMD,	PCI_DEVICEID_AMD_STRIX_HALO_ROOT,	0x70,
+	    SMU_REG_IDLEMASK_KRACKAN,	25,	amdsmu_ip_blocks_names_v2,
+	    SMU_REG_MSG_KRACKAN },
 	/*
 	 * XXX Strix Point (PCI_DEVICEID_AMD_STRIX_POINT_ROOT) doesn't support
 	 * S0i3 and thus doesn't have an idlemask.  Since our driver doesn't
diff --git a/sys/dev/amdsmu/amdsmu_reg.h b/sys/dev/amdsmu/amdsmu_reg.h
index 503472215a8f..7903afbaff8d 100644
--- a/sys/dev/amdsmu/amdsmu_reg.h
+++ b/sys/dev/amdsmu/amdsmu_reg.h
@@ -21,6 +21,7 @@
 #define PCI_DEVICEID_AMD_REMBRANDT_ROOT		0x14B5
 #define PCI_DEVICEID_AMD_PHOENIX_ROOT		0x14E8
 #define PCI_DEVICEID_AMD_STRIX_POINT_ROOT	0x14A4
+#define PCI_DEVICEID_AMD_STRIX_HALO_ROOT	0x1507
 
 #define SMU_INDEX_ADDRESS	0xB8
 #define SMU_INDEX_DATA		0xBC
-- 
2.56.0

