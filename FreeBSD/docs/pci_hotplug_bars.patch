From 11735256af9cf17309b17b3e1c142a5bfcb38b85 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Wed, 25 Nov 2026 09:48:52 +0100
Subject: [PATCH 1/2] pci: Limit BAR reservations to the BAR's width

A BAR reserved with a wildcard range, as for an unassigned BAR, a
relocated one, hw.pci.clear_bars or a driver's lazy allocation, could
be placed above 4 GB although it decodes only 32 bits; it then kept
the low 32 bits of the address.  Cap the range at the highest address
the BAR can decode.
---
 sys/dev/pci/pci.c | 27 +++++++++++++++++++++------
 1 file changed, 21 insertions(+), 6 deletions(-)

diff --git a/sys/dev/pci/pci.c b/sys/dev/pci/pci.c
index a95ace27d122..e232364a2a7c 100644
--- a/sys/dev/pci/pci.c
+++ b/sys/dev/pci/pci.c
@@ -683,6 +683,18 @@ pci_maprange(uint64_t mapreg)
 	return (ln2range);
 }
 
+/* Highest address a BAR with this map value can decode. */
+static rman_res_t
+pci_bar_maxaddr(pci_addr_t mapreg)
+{
+	int ln2range;
+
+	ln2range = pci_maprange(mapreg);
+	if (ln2range == 20 || ln2range == 32)
+		return (((rman_res_t)1 << ln2range) - 1);
+	return (~0);
+}
+
 /* adjust some values from PCI 1.0 devices to match 2.0 standards ... */
 
 static void
@@ -3414,7 +3426,7 @@ pci_add_map(device_t bus, device_t dev, int reg, struct resource_list *rl,
 {
 	struct pci_map *pm;
 	pci_addr_t base, map, testval;
-	pci_addr_t start, end, count;
+	pci_addr_t start, end, count, maxaddr;
 	int barlen, basezero, flags, maprange, mapsize, type;
 	uint16_t cmd;
 	struct resource *res;
@@ -3524,9 +3536,10 @@ pci_add_map(device_t bus, device_t dev, int reg, struct resource_list *rl,
 	flags = RF_ALIGNMENT_LOG2(mapsize);
 	if (prefetch)
 		flags |= RF_PREFETCHABLE;
+	maxaddr = pci_bar_maxaddr(map);
 	if (basezero || base == pci_mapbase(testval) || pci_clear_bars) {
 		start = 0;	/* Let the parent decide. */
-		end = ~0;
+		end = maxaddr;
 	} else {
 		start = base;
 		end = base + count - 1;
@@ -3543,7 +3556,7 @@ pci_add_map(device_t bus, device_t dev, int reg, struct resource_list *rl,
 	    flags);
 	if ((pci_do_realloc_bars
 		|| pci_has_quirk(pci_get_devid(dev), PCI_QUIRK_REALLOC_BAR))
-	    && res == NULL && (start != 0 || end != ~0)) {
+	    && res == NULL && (start != 0 || end != maxaddr)) {
 		/*
 		 * If the allocation fails, try to allocate a resource for
 		 * this BAR using any available range.  The firmware felt
@@ -3551,9 +3564,9 @@ pci_add_map(device_t bus, device_t dev, int reg, struct resource_list *rl,
 		 * disable decoding if we can help it.
 		 */
 		resource_list_delete(rl, type, reg);
-		resource_list_add(rl, type, reg, 0, ~0, count);
-		res = resource_list_reserve(rl, bus, dev, type, reg, 0, ~0,
-		    count, flags);
+		resource_list_add(rl, type, reg, 0, maxaddr, count);
+		res = resource_list_reserve(rl, bus, dev, type, reg, 0,
+		    maxaddr, count, flags);
 	}
 	if (res == NULL) {
 		/*
@@ -6183,6 +6196,8 @@ pci_reserve_map(device_t dev, device_t child, int type, int rid,
 		flags = (flags & ~RF_ALIGNMENT_MASK) | RF_ALIGNMENT_LOG2(mapsize);
 	if (PCI_BAR_MEM(map) && (map & PCIM_BAR_MEM_PREFETCH))
 		flags |= RF_PREFETCHABLE;
+	if (!PCIR_IS_BIOS(&dinfo->cfg, rid) && end > pci_bar_maxaddr(map))
+		end = pci_bar_maxaddr(map);
 
 	/*
 	 * Allocate enough resource, and then write back the
-- 
