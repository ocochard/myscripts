From a68bb9f29f9e67cd5a917f9dd20a1b012d3f2724 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Wed, 25 Nov 2026 09:48:53 +0100
Subject: [PATCH 2/2] pci: Reserve unassigned BARs below hot-plug ports

Firmware cannot assign BARs to devices that appear below a hot-plug
port after boot, and pci_add_map() leaves them until a driver asks.  By
then a sibling bridge window can block the growth of the device's
bridge window: a Thunderbolt eGPU powered on after boot got no room for
its 16 MB BAR0.

Reserve them through pci_reserve_map() once every function on the bus
holds its assigned BARs, and before drivers attach.
---
 sys/dev/pci/pci.c | 58 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/sys/dev/pci/pci.c b/sys/dev/pci/pci.c
index e232364a2a7c..f146afa57c8c 100644
--- a/sys/dev/pci/pci.c
+++ b/sys/dev/pci/pci.c
@@ -4292,6 +4292,62 @@ pci_add_resources(device_t bus, device_t dev, int force, uint32_t prefetchmask)
 	pci_reserve_secbus(bus, dev, cfg, rl);
 }
 
+static bool
+pci_below_hotplug_port(device_t bus)
+{
+	device_t pcib;
+
+	for (pcib = device_get_parent(bus); is_pci_device(pcib);
+	    pcib = device_get_parent(device_get_parent(pcib))) {
+		if (pci_find_cap(pcib, PCIY_EXPRESS, NULL) != 0)
+			continue;
+		if ((pcie_read_config(pcib, PCIER_FLAGS, 2) &
+		    PCIEM_FLAGS_SLOT) == 0)
+			continue;
+		if ((pcie_read_config(pcib, PCIER_SLOT_CAP, 4) &
+		    PCIEM_SLOT_CAP_HPC) != 0)
+			return (true);
+	}
+	return (false);
+}
+
+/*
+ * Firmware cannot assign BARs for devices that appear below a hot-plug
+ * port after boot.  Reserve them once every function on the bus holds its
+ * assigned BARs, before drivers and sibling bridges claim the space.
+ */
+static void
+pci_reserve_unassigned_bars(device_t bus)
+{
+	struct pci_devinfo *dinfo;
+	struct pci_map *pm;
+	device_t *devlist;
+	int devcount, i, type;
+
+	if (!pci_below_hotplug_port(bus))
+		return;
+	if (device_get_children(bus, &devlist, &devcount) != 0)
+		return;
+	for (i = 0; i < devcount; i++) {
+		if (device_is_attached(devlist[i]))
+			continue;
+		dinfo = device_get_ivars(devlist[i]);
+		STAILQ_FOREACH(pm, &dinfo->cfg.maps, pm_link) {
+			if (PCIR_IS_BIOS(&dinfo->cfg, pm->pm_reg) ||
+			    pci_mapbase(pm->pm_value) != 0)
+				continue;
+			type = PCI_BAR_MEM(pm->pm_value) ? SYS_RES_MEMORY :
+			    SYS_RES_IOPORT;
+			if (resource_list_find(&dinfo->resources, type,
+			    pm->pm_reg) != NULL)
+				continue;
+			(void)pci_reserve_map(bus, devlist[i], type,
+			    pm->pm_reg, 0, ~0, 1, 1, 0);
+		}
+	}
+	free(devlist, M_TEMP);
+}
+
 static struct pci_devinfo *
 pci_identify_function(device_t pcib, device_t dev, int domain, int busno,
     int slot, int func)
@@ -4349,6 +4405,7 @@ pci_add_children(device_t dev, int domain, int busno)
 		for (f = first_func; f <= pcifunchigh; f++)
 			pci_identify_function(pcib, dev, domain, busno, s, f);
 	}
+	pci_reserve_unassigned_bars(dev);
 	pcie_reconcile_link_mps(dev);
 #undef REG
 }
@@ -4424,6 +4481,7 @@ pci_rescan_method(device_t dev)
 
 	free(devlist, M_TEMP);
 	oldcount = devcount;
+	pci_reserve_unassigned_bars(dev);
 
 	/* Try to attach the devices just added. */
 	error = device_get_children(dev, &devlist, &devcount);
-- 
2.56.0

