diff --git a/stand/efi/loader/decompress.h b/stand/efi/loader/decompress.h
index f9d4fe4..5740cef 100644
--- a/stand/efi/loader/decompress.h
+++ b/stand/efi/loader/decompress.h
@@ -11,7 +11,19 @@ enum step_return { ok, done, err };
 
 typedef struct decomp_state decomp_state;
 
-decomp_state *decomp_init(uint8_t *buf, size_t buflen, size_t size_hint);
+/*
+ * Memory types for an image that outlives the loader.  A buffer registered
+ * with EFI_RAM_DISK_PROTOCOL is a virtual disk, which ACPI (NFIT, SPA Range
+ * Structure) requires to be EfiReservedMemoryType.  UEFI forbids OS loaders to
+ * allocate that type otherwise, so a buffer only the md driver uses gets a type
+ * from the range UEFI leaves to OS loaders (0x80000000-0xffffffff).  The
+ * kernel keeps both out of physmap.
+ */
+#define	MEMDISK_RAM_DISK_MEMORY_TYPE	EfiReservedMemoryType
+#define	MEMDISK_MD_MEMORY_TYPE		((EFI_MEMORY_TYPE)0x80000000)
+
+decomp_state *decomp_init(uint8_t *buf, size_t buflen, size_t size_hint,
+    EFI_MEMORY_TYPE mem_type);
 enum step_return decomp_step(decomp_state *dctx, uint8_t *buf, size_t len, size_t offset);
 void decomp_fini(decomp_state *dctx, bool flush);
 EFI_PHYSICAL_ADDRESS decomp_buffer(decomp_state *dctx);
