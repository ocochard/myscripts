From c1c5bf89ef348b19797f10e646daca1f7de25db8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Olivier=20Cochard-Labb=C3=A9?= <olivier@cochard.me>
Date: Thu, 12 Nov 2026 17:30:31 +0000
Subject: [PATCH 1/9] LinuxKPI: idr: allow lookups after idr_destroy()

On Linux idr_destroy() leaves an empty, usable idr; ours also destroys the
lock, so mt76 cleaning a station twice panicked in idr_remove().
---
 sys/compat/linuxkpi/common/src/linux_idr.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sys/compat/linuxkpi/common/src/linux_idr.c b/sys/compat/linuxkpi/common/src/linux_idr.c
index 7e5f0d28867e..c8852cf7ef05 100644
--- a/sys/compat/linuxkpi/common/src/linux_idr.c
+++ b/sys/compat/linuxkpi/common/src/linux_idr.c
@@ -273,6 +273,9 @@ idr_remove(struct idr *idr, int id)
 {
 	void *res;
 
+	/* Linux allows lookups on an idr after idr_destroy(): it is empty. */
+	if (IDR_LOCK_INITALIZED(idr) == 0)
+		return (NULL);
 	IDR_LOCK(idr);
 	res = idr_remove_locked(idr, id);
 	IDR_UNLOCK(idr);
@@ -340,6 +343,8 @@ idr_find(struct idr *idr, int id)
 {
 	void *res;
 
+	if (IDR_LOCK_INITALIZED(idr) == 0)
+		return (NULL);
 	IDR_LOCK(idr);
 	res = idr_find_locked(idr, id);
 	IDR_UNLOCK(idr);
@@ -352,6 +357,8 @@ idr_get_next(struct idr *idr, int *nextidp)
 	void *res = NULL;
 	int id = *nextidp;
 
+	if (IDR_LOCK_INITALIZED(idr) == 0)
+		return (NULL);
 	IDR_LOCK(idr);
 	for (; id <= idr_max(idr); id++) {
 		res = idr_find_locked(idr, id);
