From b32f98067b1ac4945bf3a885133bf95fecdcc9fa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Olivier=20Cochard-Labb=C3=A9?= <olivier@cochard.me>
Date: Thu, 12 Nov 2026 17:30:32 +0000
Subject: [PATCH 8/9] LinuxKPI: 802.11: set an airtime estimate on dequeued
 frames

mac80211 sets tx_time_est for AQL; mt76 limits frames without one to 16
in flight per station.
---
 sys/compat/linuxkpi/common/src/linux_80211.c | 29 ++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/sys/compat/linuxkpi/common/src/linux_80211.c b/sys/compat/linuxkpi/common/src/linux_80211.c
index cde4b820b4dd..a4eed95513e1 100644
--- a/sys/compat/linuxkpi/common/src/linux_80211.c
+++ b/sys/compat/linuxkpi/common/src/linux_80211.c
@@ -9079,6 +9079,33 @@ linuxkpi_ieee80211_find_sta_by_ifaddr(struct ieee80211_hw *hw,
 	return (sta);
 }
 
+/*
+ * mac80211 gives every frame it dequeues an airtime estimate (for AQL), and
+ * drivers such as mt76 throttle frames without one.  Estimate it from the
+ * node's net80211 TX rate; we have no AQL limits ourselves.
+ */
+static void
+lkpi_80211_txq_set_time_est(struct ieee80211_txq *txq, struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info;
+	struct ieee80211_node *ni;
+	uint32_t kbps, us;
+
+	kbps = 0;
+	if (txq->sta != NULL) {
+		ni = STA_TO_LSTA(txq->sta)->ni;
+		if (ni != NULL &&
+		    ni->ni_txrate.type != IEEE80211_NODE_TXRATE_UNDEFINED)
+			kbps = ieee80211_node_get_txrate_kbit(ni);
+	}
+	if (kbps == 0)
+		kbps = 6000;
+	us = howmany((uint64_t)skb->len * 8 * 1000, kbps);
+	/* 10 bit field in 4us units. */
+	info = IEEE80211_SKB_CB(skb);
+	info->tx_time_est = MAX(1, MIN(howmany(us, 4), 1023));
+}
+
 struct sk_buff *
 linuxkpi_ieee80211_tx_dequeue(struct ieee80211_hw *hw,
     struct ieee80211_txq *txq)
@@ -9108,6 +9135,8 @@ linuxkpi_ieee80211_tx_dequeue(struct ieee80211_hw *hw,
 	if (skb != NULL)
 		ltxq->frms_dequeued++;
 	LKPI_80211_LTXQ_UNLOCK(ltxq);
+	if (skb != NULL)
+		lkpi_80211_txq_set_time_est(txq, skb);
 
 stopped:
 	return (skb);
