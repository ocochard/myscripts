+/*
+ * Report a registered md's size, so probe_md_currdev() can hand it to
+ * disk_open() without reaching into the private struct md_info.
+ */
+int
+md_get_size(int unit, uint64_t *size)
+{
+	struct md_info *md;
+
+	md = md_get_info(unit);
+	if (md == NULL)
+		return (ENXIO);
+	*size = md->md_size;
+	return (0);
+}
