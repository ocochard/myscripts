++/*
++ * backlight(9) devices are registered by the graphics drivers.  On panels
++ * where the ACPI video methods change nothing (OLED panels driven by
++ * amdgpu, for example), they are the only way to change the brightness, so
++ * they are preferred to acpi_video(4).  Their brightness is a percentage.
++ */
++#define BACKLIGHT_DEVICE_FMT "/dev/backlight/backlight%d"
++#define BACKLIGHT_MAX_BRIGHTNESS 100
++
++static gint
++backlight_dev_open (gint flags)
++{
++  struct backlight_info info;
++  gchar *path;
++  gint fd, i;
++
++  for (i = 0; i < MAX_DEVICE_NUM; i++)
++  {
++    path = g_strdup_printf (BACKLIGHT_DEVICE_FMT, i);
++    fd = open (path, flags);
++    g_free (path);
++    if (fd == -1)
++      continue;
++    if (ioctl (fd, BACKLIGHTGETINFO, &info) == 0
++        && info.type == BACKLIGHT_TYPE_PANEL)
++      return fd;
++    close (fd);
++  }
++
++  return -1;
++}
++
++static gint
++backlight_dev_get_brightness (void)
++{
++  struct backlight_props props;
++  gint fd, res = -1;
++
++  fd = backlight_dev_open (O_RDONLY);
++  if (fd == -1)
++    return -1;
++  if (ioctl (fd, BACKLIGHTGETSTATUS, &props) == 0)
++    res = props.brightness;
++  close (fd);
++
++  return res;
++}
++
++static gboolean
++backlight_dev_set_brightness (gint value)
++{
++  struct backlight_props props;
++  gboolean result = FALSE;
++  gint fd;
++
++  fd = backlight_dev_open (O_RDWR);
++  if (fd == -1)
++    return FALSE;
++  if (ioctl (fd, BACKLIGHTGETSTATUS, &props) == 0)
++  {
++    props.brightness = CLAMP (value, 0, BACKLIGHT_MAX_BRIGHTNESS);
++    if (ioctl (fd, BACKLIGHTUPDATESTATUS, &props) == 0)
++      result = TRUE;
++  }
++  close (fd);
++
++  return result;
++}
++
