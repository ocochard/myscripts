+static void *
+lkpi_skb_slab_alloc(uma_zone_t zone, vm_size_t size, int domain,
+    uint8_t *pflag, int wait)
+{
+
+	*pflag = UMA_SLAB_KERNEL;
+	return ((void *)kmem_alloc_contig_domainset(DOMAINSET_FIXED(domain),
+	    size, wait, 0, lkpi_skb_high, PAGE_SIZE, 0, VM_MEMATTR_DEFAULT));
+}
+
+static void
+lkpi_skb_slab_free(void *item, vm_size_t size, uint8_t pflag)
+{
+
+	kmem_free(item, size);
+}
+
+static uma_zone_t
+lkpi_skb_zone_find(size_t len)
+{
+	u_int i;
+
+	for (i = 0; i < lkpi_skb_nzones; i++)
+		if (len <= (LKPI_SKB_ZONE_MINSIZE << i))
+			return (lkpi_skb_zone[i]);
+	return (NULL);
