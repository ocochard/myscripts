diff --git sys/dev/gpio/intel/intelgpio.c sys/dev/gpio/intel/intelgpio.c
index aba4c12da828..971063a3520f 100644
--- sys/dev/gpio/intel/intelgpio.c
+++ sys/dev/gpio/intel/intelgpio.c
@@ -13,6 +13,7 @@
 #include <sys/rman.h>
 
 #include <machine/bus.h>
+#include <machine/intr_machdep.h>
 #include <machine/resource.h>
 
 #include <contrib/dev/acpica/include/acpi.h>
@@ -308,6 +309,254 @@ intelgpio_pin_toggle(device_t dev, uint32_t pin)
 	return (0);
 }
 
+/*
+ * Find the community, the group index within that community and the bit
+ * within the group registers of a pin.  The group index selects the
+ * HOSTSW_OWN, GPI_IS and GPI_IE register of the group.
+ */
+static int
+intelgpio_pin_to_group(struct intelgpio_softc *sc, uint32_t pin, int *comp,
+    int *grpp, int *bitp)
+{
+	const struct intelgpio_platform *plat = sc->sc_plat;
+	const struct intelgpio_community *com;
+	const struct intelgpio_padgroup *pg;
+	int i, j;
+
+	for (i = 0; i < plat->ncommunities; i++) {
+		com = &plat->communities[i];
+		for (j = 0; j < com->ngroups; j++) {
+			pg = &com->groups[j];
+			if (pg->gpio_base == INTELGPIO_GPIO_NOMAP)
+				continue;
+			if (pin >= pg->gpio_base &&
+			    pin < pg->gpio_base + pg->npads) {
+				*comp = i;
+				*grpp = j;
+				*bitp = pin - pg->gpio_base;
+				return (0);
+			}
+		}
+	}
+	return (-1);
+}
+
+static void
+intelgpio_set_ie(struct intelgpio_softc *sc, struct resource *res, int grp,
+    int bit, bool enable)
+{
+	bus_size_t reg;
+	uint32_t val;
+
+	reg = sc->sc_plat->gpi_ie_reg + grp * 4;
+	INTELGPIO_LOCK(sc);
+	val = bus_read_4(res, reg);
+	if (enable)
+		val |= 1u << bit;
+	else
+		val &= ~(1u << bit);
+	bus_write_4(res, reg, val);
+	INTELGPIO_UNLOCK(sc);
+}
+
+static void
+intelgpio_intr_set_pin(device_t dev, u_int pin, bool enable)
+{
+	struct intelgpio_softc *sc;
+	int bit, com, grp;
+
+	sc = device_get_softc(dev);
+	if (intelgpio_pin_to_group(sc, pin, &com, &grp, &bit) != 0 ||
+	    sc->sc_mem_res[com] == NULL)
+		return;
+	intelgpio_set_ie(sc, sc->sc_mem_res[com], grp, bit, enable);
+}
+
+static void
+intelgpio_intr_mask(device_t dev, u_int pin)
+{
+	intelgpio_intr_set_pin(dev, pin, false);
+}
+
+static void
+intelgpio_intr_unmask(device_t dev, u_int pin)
+{
+	intelgpio_intr_set_pin(dev, pin, true);
+}
+
+static int
+intelgpio_intr_config(device_t dev, u_int pin, uint32_t mode)
+{
+	struct intelgpio_softc *sc;
+	const struct intelgpio_platform *plat;
+	struct resource *res;
+	bus_size_t pad_off, reg;
+	uint32_t cfg, evcfg;
+	int bit, com, grp;
+
+	sc = device_get_softc(dev);
+	plat = sc->sc_plat;
+
+	switch (mode & GPIO_INTR_MASK) {
+	case GPIO_INTR_LEVEL_LOW:
+		evcfg = INTELGPIO_PADCFG0_RXEVCFG_LEVEL |
+		    INTELGPIO_PADCFG0_RXINV;
+		break;
+	case GPIO_INTR_LEVEL_HIGH:
+		evcfg = INTELGPIO_PADCFG0_RXEVCFG_LEVEL;
+		break;
+	case GPIO_INTR_EDGE_RISING:
+		evcfg = INTELGPIO_PADCFG0_RXEVCFG_EDGE;
+		break;
+	case GPIO_INTR_EDGE_FALLING:
+		evcfg = INTELGPIO_PADCFG0_RXEVCFG_EDGE |
+		    INTELGPIO_PADCFG0_RXINV;
+		break;
+	default:
+		return (EOPNOTSUPP);
+	}
+
+	if (intelgpio_gpio_to_pad(sc, pin, &res, &pad_off, NULL) != 0 ||
+	    res == NULL)
+		return (EINVAL);
+	if (intelgpio_pin_to_group(sc, pin, &com, &grp, &bit) != 0)
+		return (EINVAL);
+
+	INTELGPIO_LOCK(sc);
+	cfg = bus_read_4(res, pad_off);
+	if ((cfg & INTELGPIO_PADCFG0_PMODE_MASK) !=
+	    INTELGPIO_PADCFG0_PMODE_GPIO) {
+		INTELGPIO_UNLOCK(sc);
+		return (EINVAL);
+	}
+
+	/* Mask the pin while it is reprogrammed. */
+	reg = plat->gpi_ie_reg + grp * 4;
+	bus_write_4(res, reg, bus_read_4(res, reg) & ~(1u << bit));
+
+	cfg &= ~(INTELGPIO_PADCFG0_RXEVCFG_MASK | INTELGPIO_PADCFG0_RXINV |
+	    INTELGPIO_PADCFG0_GPIORXDIS);
+	cfg |= evcfg;
+	bus_write_4(res, pad_off, cfg);
+	if ((bus_read_4(res, pad_off) &
+	    (INTELGPIO_PADCFG0_RXEVCFG_MASK | INTELGPIO_PADCFG0_RXINV |
+	    INTELGPIO_PADCFG0_GPIORXDIS)) != evcfg) {
+		/* The pad configuration is locked. */
+		INTELGPIO_UNLOCK(sc);
+		return (EPERM);
+	}
+
+	/* Host GPIO driver mode: the event goes to GPI_IS, not to a GPE. */
+	reg = plat->hostsw_own_reg + grp * 4;
+	bus_write_4(res, reg, bus_read_4(res, reg) | (1u << bit));
+
+	/* Drop an event latched under the previous configuration. */
+	bus_write_4(res, plat->gpi_is_reg + grp * 4, 1u << bit);
+	INTELGPIO_UNLOCK(sc);
+
+	return (0);
+}
+
+static const struct gpio_intr_ops intelgpio_intr_ops = {
+	.gio_config = intelgpio_intr_config,
+	.gio_mask = intelgpio_intr_mask,
+	.gio_unmask = intelgpio_intr_unmask,
+};
+
+/*
+ * All communities share one interrupt.  Acknowledge each enabled pending
+ * event, then run the handlers of its pin.
+ */
+static int
+intelgpio_intr(void *arg)
+{
+	struct intelgpio_softc *sc = arg;
+	const struct intelgpio_platform *plat = sc->sc_plat;
+	const struct intelgpio_community *com;
+	const struct intelgpio_padgroup *pg;
+	struct resource *res;
+	bus_size_t is_reg;
+	uint32_t pending;
+	int bit, i, j;
+	bool handled;
+
+	handled = false;
+	for (i = 0; i < plat->ncommunities; i++) {
+		res = sc->sc_mem_res[i];
+		if (res == NULL)
+			continue;
+		com = &plat->communities[i];
+		for (j = 0; j < com->ngroups; j++) {
+			pg = &com->groups[j];
+			is_reg = plat->gpi_is_reg + j * 4;
+
+			INTELGPIO_LOCK(sc);
+			pending = bus_read_4(res, is_reg) &
+			    bus_read_4(res, plat->gpi_ie_reg + j * 4);
+			if (pending != 0)
+				bus_write_4(res, is_reg, pending);
+			INTELGPIO_UNLOCK(sc);
+
+			while (pending != 0) {
+				handled = true;
+				bit = ffs(pending) - 1;
+				pending &= ~(1u << bit);
+				if (pg->gpio_base == INTELGPIO_GPIO_NOMAP ||
+				    gpio_intr_dispatch(sc->sc_gpio_intr,
+				    pg->gpio_base + bit) != 0)
+					intelgpio_set_ie(sc, res, j, bit,
+					    false);
+			}
+		}
+	}
+	return (handled ? FILTER_HANDLED : FILTER_STRAY);
+}
+
+static void
+intelgpio_intr_attach(struct intelgpio_softc *sc)
+{
+	const struct intelgpio_platform *plat = sc->sc_plat;
+	device_t dev = sc->sc_dev;
+	int error, i, j, maxpin, rid;
+
+	/* No consumer exists yet: start with every pin masked. */
+	for (i = 0; i < plat->ncommunities; i++) {
+		if (sc->sc_mem_res[i] == NULL)
+			continue;
+		for (j = 0; j < plat->communities[i].ngroups; j++)
+			bus_write_4(sc->sc_mem_res[i], plat->gpi_ie_reg + j * 4,
+			    0);
+	}
+
+	rid = 0;
+	sc->sc_irq_res = bus_alloc_resource_any(dev, SYS_RES_IRQ, &rid,
+	    RF_ACTIVE | RF_SHAREABLE);
+	if (sc->sc_irq_res == NULL) {
+		device_printf(dev, "no interrupt, pin interrupts disabled\n");
+		return;
+	}
+
+	intelgpio_pin_max(dev, &maxpin);
+	sc->sc_gpio_intr = gpio_intr_register(dev, maxpin + 1,
+	    &intelgpio_intr_ops);
+	if (sc->sc_gpio_intr == NULL)
+		goto fail;
+
+	error = bus_setup_intr(dev, sc->sc_irq_res,
+	    INTR_TYPE_MISC | INTR_MPSAFE, intelgpio_intr, NULL, sc,
+	    &sc->sc_intrhand);
+	if (error != 0) {
+		device_printf(dev, "cannot set up interrupt: %d\n", error);
+		gpio_intr_deregister(sc->sc_gpio_intr);
+		sc->sc_gpio_intr = NULL;
+		goto fail;
+	}
+	return;
+fail:
+	bus_release_resource(dev, SYS_RES_IRQ, rid, sc->sc_irq_res);
+	sc->sc_irq_res = NULL;
+}
+
 int
 intelgpio_probe(device_t dev, const struct intelgpio_platform *plat)
 {
@@ -326,10 +575,28 @@ static int
 intelgpio_detach(device_t dev)
 {
 	struct intelgpio_softc *sc;
-	int i;
+	int error, i;
 
 	sc = device_get_softc(dev);
 
+	if (sc->sc_gpio_intr != NULL) {
+		bus_teardown_intr(dev, sc->sc_irq_res, sc->sc_intrhand);
+		error = gpio_intr_deregister(sc->sc_gpio_intr);
+		if (error != 0) {
+			/* A consumer still has a handler on one of our pins. */
+			bus_setup_intr(dev, sc->sc_irq_res,
+			    INTR_TYPE_MISC | INTR_MPSAFE, intelgpio_intr, NULL,
+			    sc, &sc->sc_intrhand);
+			return (error);
+		}
+		sc->sc_gpio_intr = NULL;
+	}
+	if (sc->sc_irq_res != NULL) {
+		bus_release_resource(dev, SYS_RES_IRQ,
+		    rman_get_rid(sc->sc_irq_res), sc->sc_irq_res);
+		sc->sc_irq_res = NULL;
+	}
+
 	if (sc->sc_busdev != NULL)
 		gpiobus_detach_bus(dev);
 
@@ -382,6 +649,9 @@ intelgpio_attach(device_t dev, const struct intelgpio_platform *plat)
 		return (ENXIO);
 	}
 
+	if (plat->hostsw_own_reg != 0)
+		intelgpio_intr_attach(sc);
+
 	sc->sc_busdev = gpiobus_add_bus(dev);
