diff --git sys/dev/gpio/intel/mtlgpio.c sys/dev/gpio/intel/mtlgpio.c
new file mode 100644
index 000000000000..76778d5da3a6
--- /dev/null
+++ sys/dev/gpio/intel/mtlgpio.c
@@ -0,0 +1,126 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 Olivier Cochard-Labbe <olivier@FreeBSD.org>
+ */
+
+/*
+ * Intel Meteor Lake-P GPIO controller (ACPI INTC1083).
+ *
+ * Group names and register offsets: "Intel Core Ultra Processors for
+ * H-series and U-series Platforms SOC I/O Registers", Intel document 795260
+ * (GPIO Community 0, 1, 3, 4 and 5 registers).  Pad counts and ACPI GPIO
+ * bases: the GPIO group table (GPCM) of the platform DSDT.  Groups without
+ * a public name are named after their community and group index, such as
+ * COM3_GRP2_ for group 2 of community 3.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/bus.h>
+#include <sys/gpio.h>
+#include <sys/kernel.h>
+#include <sys/module.h>
+
+#include <contrib/dev/acpica/include/acpi.h>
+
+#include <dev/acpica/acpivar.h>
+#include <dev/gpio/gpiobusvar.h>
+
+#include "intelgpio.h"
+
+#include "gpio_if.h"
+#include "opt_acpi.h"
+
+/* Community 0: COM0_GRP0, GPP_V, GPP_C */
+static const struct intelgpio_padgroup mtl_com0_groups[] = {
+	{ .first_pad = 0, .npads = 5, .gpio_base = 0, .name = "COM0_GRP0_" },
+	{ .first_pad = 5, .npads = 24, .gpio_base = 32, .name = "GPP_V" },
+	{ .first_pad = 29, .npads = 24, .gpio_base = 64, .name = "GPP_C" },
+};
+
+/* Community 1: GPP_A, GPP_E */
+static const struct intelgpio_padgroup mtl_com1_groups[] = {
+	{ .first_pad = 53, .npads = 25, .gpio_base = 96, .name = "GPP_A" },
+	{ .first_pad = 78, .npads = 25, .gpio_base = 128, .name = "GPP_E" },
+};
+
+/* Community 3: GPP_H, GPP_F, COM3_GRP2, COM3_GRP3 */
+static const struct intelgpio_padgroup mtl_com3_groups[] = {
+	{ .first_pad = 103, .npads = 26, .gpio_base = 160, .name = "GPP_H" },
+	{ .first_pad = 129, .npads = 26, .gpio_base = 192, .name = "GPP_F" },
+	{ .first_pad = 155,
+	    .npads = 15,
+	    .gpio_base = 224,
+	    .name = "COM3_GRP2_" },
+	{ .first_pad = 170,
+	    .npads = 14,
+	    .gpio_base = 256,
+	    .name = "COM3_GRP3_" },
+};
+
+/* Community 4: GPP_S, COM4_GRP1 */
+static const struct intelgpio_padgroup mtl_com4_groups[] = {
+	{ .first_pad = 184, .npads = 8, .gpio_base = 288, .name = "GPP_S" },
+	{ .first_pad = 192,
+	    .npads = 12,
+	    .gpio_base = 320,
+	    .name = "COM4_GRP1_" },
+};
+
+/* Community 5: GPP_B, GPP_D, COM5_GRP2 */
+static const struct intelgpio_padgroup mtl_com5_groups[] = {
+	{ .first_pad = 204, .npads = 25, .gpio_base = 352, .name = "GPP_B" },
+	{ .first_pad = 229, .npads = 25, .gpio_base = 384, .name = "GPP_D" },
+	{ .first_pad = 254,
+	    .npads = 35,
+	    .gpio_base = 416,
+	    .name = "COM5_GRP2_" },
+};
+
+static const struct intelgpio_community mtl_communities[] = {
+	{ .ngroups = nitems(mtl_com0_groups), .groups = mtl_com0_groups },
+	{ .ngroups = nitems(mtl_com1_groups), .groups = mtl_com1_groups },
+	{ .ngroups = nitems(mtl_com3_groups), .groups = mtl_com3_groups },
+	{ .ngroups = nitems(mtl_com4_groups), .groups = mtl_com4_groups },
+	{ .ngroups = nitems(mtl_com5_groups), .groups = mtl_com5_groups },
+};
+
+static char *mtl_hids[] = { "INTC1083", NULL };
+
+static const struct intelgpio_platform mtl_platform = {
+	.communities = mtl_communities,
+	.ncommunities = nitems(mtl_communities),
+	.hids = mtl_hids,
+	.desc = "Intel Meteor Lake-P GPIO",
+	.hostsw_own_reg = 0x140,
+	.gpi_is_reg = 0x200,
+	.gpi_ie_reg = 0x210,
+};
+
+static int
+mtl_gpio_probe(device_t dev)
+{
+	return (intelgpio_probe(dev, &mtl_platform));
+}
+
+static int
+mtl_gpio_attach(device_t dev)
+{
+	return (intelgpio_attach(dev, &mtl_platform));
+}
+
+static device_method_t mtl_methods[] = { DEVMETHOD(device_probe,
+					     mtl_gpio_probe),
+	DEVMETHOD(device_attach, mtl_gpio_attach),
+
+	DEVMETHOD_END };
+
+DEFINE_CLASS_1(gpio, mtl_driver, mtl_methods, sizeof(struct intelgpio_softc),
+    intelgpio_driver);
+
+DRIVER_MODULE(mtlgpio, acpi, mtl_driver, NULL, NULL);
+MODULE_DEPEND(mtlgpio, acpi, 1, 1, 1);
+MODULE_DEPEND(mtlgpio, gpiobus, 1, 1, 1);
+MODULE_VERSION(mtlgpio, 1);
+ACPI_PNP_INFO(mtl_hids);
