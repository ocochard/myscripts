+/* libc and libthr make their system calls through libsys */
+static int libsys_addr_cb( struct dl_phdr_info *info, size_t size, void *arg )
+{
+    const char *p;
+    unsigned int i;
+
+    if ((p = strrchr( info->dlpi_name, '/' )))
+        ++p;
+    else
+        p = info->dlpi_name;
+
+    if (strcmp( p, "libsys.so.7" ))
+        return 0;
+
+    libsys_addr = info->dlpi_addr;
+    libsys_size = 0;
+    for (i = 0; i < info->dlpi_phnum; ++i)
+        libsys_size = max( libsys_size, info->dlpi_phdr[i].p_vaddr + info->dlpi_phdr[i].p_memsz );
+
+    return 1;
+}
