+#ifdef __FreeBSD__
+	/*
+	 * LinuxKPI vmap() ignores pgprot and maps the pages write-back.
+	 * Callers ask for WC when the GPU does not snoop the CPU caches,
+	 * e.g. the MTL media GT (Wa_22016122933): set the attribute here.
+	 */
+	if (vaddr && type == I915_MAP_WC &&
