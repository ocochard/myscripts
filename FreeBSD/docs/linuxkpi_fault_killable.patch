From 9b172375d43595da8afaf6a1794f42d359189e1f Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Mon, 23 Nov 2026 10:29:11 +0100
Subject: [PATCH] linuxkpi: Let a killed process leave a retried fault

linux_cdev_pager_populate() calls the fault handler again for as long
as it returns VM_FAULT_NOPAGE without inserting a page.  When the page
can never be inserted, for instance because another mapping of the
same buffer holds it, the loop never ends: the thread spins in the
kernel and kill -9 cannot end the process.

Stop retrying once SIGKILL is pending or the process has started to
exit, and fail the fault.  Nothing changes for a process that is not
dying, so transient retries and non-fatal signals behave as before.
Linux returns from such a fault to user space and handles the signal
there; a FreeBSD pager cannot, so it fails the fault instead.
---
 sys/compat/linuxkpi/common/src/linux_compat.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/sys/compat/linuxkpi/common/src/linux_compat.c b/sys/compat/linuxkpi/common/src/linux_compat.c
index 08c7cfdac8ed..34cf7753d847 100644
--- a/sys/compat/linuxkpi/common/src/linux_compat.c
+++ b/sys/compat/linuxkpi/common/src/linux_compat.c
@@ -538,6 +538,16 @@ linux_cdev_pager_populate(vm_object_t vm_obj, vm_pindex_t pidx, int fault_type,
 		err = vmap->vm_ops->fault(&vmf);
 
 		while (vmap->vm_pfn_count == 0 && err == VM_FAULT_NOPAGE) {
+			/*
+			 * The handler may never insert the page, e.g. when
+			 * another mapping holds it.  Give up once the process
+			 * is killed or exiting, else it can never exit.
+			 */
+			if ((curproc->p_flag2 & P2_WEXIT) != 0 ||
+			    fatal_signal_pending(current)) {
+				err = VM_FAULT_SIGSEGV;
+				break;
+			}
 			kern_yield(PRI_USER);
 			err = vmap->vm_ops->fault(&vmf);
 		}
-- 
