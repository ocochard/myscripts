From 1b11e3a3abbf715a91ba2f7a04b79d018f1adb94 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Mon, 23 Nov 2026 10:29:11 +0100
Subject: [PATCH] linuxkpi: Bound the retries of a fault handler that inserts
 no page

linux_cdev_pager_populate() calls the fault handler again for as long
as it returns VM_FAULT_NOPAGE without inserting a page.  When the page
can never be inserted, for instance because another mapping of the
same buffer holds it, the thread loops in the kernel forever, about
450000 handler calls per second, and kill -9 cannot end the process.

Bound the retries in time, as vm_fault does for page allocation
(vm.pfault_oom_attempts, vm.pfault_oom_wait): after
compat.linuxkpi.fault_retry_timeout seconds the fault fails and the
thread gets SIGSEGV.  Sleep a tick before each retry.

The 30 s default is three times the 10 s after which amdgpu declares a
kernel job hung: a legitimate retry can wait for a buffer move, and a
hung move ends with that timeout and the reset.  Retries are rare:
on i915 (Raptor Lake, Meteor Lake) and amdgpu (Strix Halo), VA-API,
vkmark and llama.cpp loads gave 389768 faults and no retry.  0 fails
at once, -1 retries forever.

Reviewed by:	imp, kib
MFC after:	2 weeks
Pull Request:	https://ron-dev.freebsd.org/FreeBSD/src/pulls/131
---
 sys/compat/linuxkpi/common/src/linux_compat.c | 30 +++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/sys/compat/linuxkpi/common/src/linux_compat.c b/sys/compat/linuxkpi/common/src/linux_compat.c
index 08c7cfdac8ed..70bc4f692468 100644
--- a/sys/compat/linuxkpi/common/src/linux_compat.c
+++ b/sys/compat/linuxkpi/common/src/linux_compat.c
@@ -134,6 +134,14 @@ SYSCTL_INT(_compat_linuxkpi, OID_AUTO, warn_dump_stack, CTLFLAG_RWTUN,
     &linuxkpi_warn_dump_stack, 0,
     "Set to enable stack traces from WARN_ON(). Clear to disable.");
 
+static int lkpi_fault_retry_timeout = 30;
+SYSCTL_INT(_compat_linuxkpi, OID_AUTO, fault_retry_timeout, CTLFLAG_RWTUN,
+    &lkpi_fault_retry_timeout, 0,
+    "Seconds a page fault retries a driver fault handler that inserts no page "
+    "before failing (0: fail at once, -1: retry forever)");
+static struct timeval lkpi_fault_lastlog;
+static int lkpi_fault_curpps;
+
 static struct timeval lkpi_net_lastlog;
 static int lkpi_net_curpps;
 static int lkpi_net_maxpps = 99;
@@ -507,7 +515,7 @@ linux_cdev_pager_populate(vm_object_t vm_obj, vm_pindex_t pidx, int fault_type,
     vm_prot_t max_prot, vm_pindex_t *first, vm_pindex_t *last)
 {
 	struct vm_area_struct *vmap;
-	int err;
+	int err, start, timeout;
 
 	/* get VM area structure */
 	vmap = linux_cdev_handle_find(vm_obj->handle);
@@ -537,8 +545,26 @@ linux_cdev_pager_populate(vm_object_t vm_obj, vm_pindex_t pidx, int fault_type,
 
 		err = vmap->vm_ops->fault(&vmf);
 
+		/*
+		 * If err == VM_FAULT_NOPAGE and no page was inserted, the
+		 * handler asked to be called again.  It may never insert
+		 * the page, e.g. when another mapping holds it, so bound the
+		 * retries in time, as vm_fault does for page allocation.
+		 */
+		start = ticks;
 		while (vmap->vm_pfn_count == 0 && err == VM_FAULT_NOPAGE) {
-			kern_yield(PRI_USER);
+			timeout = lkpi_fault_retry_timeout;
+			if (timeout >= 0 && (ticks - start) / hz >= timeout) {
+				if (ppsratecheck(&lkpi_fault_lastlog,
+				    &lkpi_fault_curpps, 1))
+					printf("linuxkpi: pid %d (%s): fault not "
+					    "served after %d s, failing it\n",
+					    curproc->p_pid, curproc->p_comm,
+					    timeout);
+				err = VM_FAULT_SIGSEGV;
+				break;
+			}
+			pause("lkpiflt", 1);
 			err = vmap->vm_ops->fault(&vmf);
 		}
 	}
-- 
2.56.0

