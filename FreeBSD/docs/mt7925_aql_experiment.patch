 		lkpi_80211_txq_set_time_est(txq, skb);
+		lkpi_80211_aql_charge(hw, skb);
+	}
 
 stopped:
 	return (skb);
@@ -9196,6 +9268,8 @@ _lkpi_ieee80211_free_txskb(struct ieee80211_hw *hw, struct sk_buff *skb,
 
 	if (m != NULL) {
 		ni = m->m_pkthdr.PH_loc.ptr;
+		if (ni != NULL)
+			lkpi_80211_aql_refund(hw, skb, ni);
 		/* Status: 0 is ok, != 0 is error. */
 		ieee80211_tx_complete(ni, m, status);
 		/* ni & mbuf were consumed. */
@@ -9791,6 +9865,9 @@ linuxkpi_ieee80211_next_txq(struct ieee80211_hw *hw, uint8_t ac)
 		goto out;
 	if ((ltxq->flags & (LKPI_TXQ_STOPPED|LKPI_TXQ_STOPPED_BA)) != 0)
 		goto out;
+	/* Over its airtime limit: stay scheduled, completions reschedule. */
+	if (!lkpi_80211_aql_ok(lhw, ltxq))
+		goto out;
 
 	IMPROVE("check AIRTIME_FAIRNESS");
 
