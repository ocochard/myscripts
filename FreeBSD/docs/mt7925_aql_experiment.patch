 	info->tx_time_est = MAX(1, MIN(howmany(us, 4), 1023));
 }
 
+/*
+ * AQL: charge the estimate of each dequeued frame to its station and AC
+ * until the frame is reported back, as mac80211 does.
+ */
+static void
+lkpi_80211_aql_charge(struct ieee80211_hw *hw, struct sk_buff *skb)
+{
+	struct ieee80211_node *ni;
+	struct lkpi_sta *lsta;
+	u_int us;
+
+	if (skb->m == NULL)
+		return;
+	ni = ((struct mbuf *)skb->m)->m_pkthdr.PH_loc.ptr;
+	if (ni == NULL || (lsta = ni->ni_drv_data) == NULL)
+		return;
+	us = IEEE80211_SKB_CB(skb)->tx_time_est * 4;
+	atomic_add_int(&lsta->aql_pending[skb_get_queue_mapping(skb)], us);
+	atomic_add_int(&HW_TO_LHW(hw)->aql_total, us);
+	skb->_flags |= _SKB_AQL;
+}
+
+static void
+lkpi_80211_aql_refund(struct ieee80211_hw *hw, struct sk_buff *skb,
+    struct ieee80211_node *ni)
+{
+	struct lkpi_sta *lsta;
+	u_int us;
+
+	if ((skb->_flags & _SKB_AQL) == 0)
+		return;
+	skb->_flags &= ~_SKB_AQL;
+	us = IEEE80211_SKB_CB(skb)->tx_time_est * 4;
+	lsta = ni->ni_drv_data;
+	if (lsta != NULL)
+		atomic_subtract_int(
+		    &lsta->aql_pending[skb_get_queue_mapping(skb)], us);
+	atomic_subtract_int(&HW_TO_LHW(hw)->aql_total, us);
+}
+
+/* mac80211's ieee80211_txq_airtime_check(). */
+static bool
+lkpi_80211_aql_ok(struct lkpi_hw *lhw, struct lkpi_txq *ltxq)
+{
+	struct lkpi_sta *lsta;
+	u_int pending;
+
+	if (!lkpi_aql || ltxq->txq.sta == NULL)
+		return (true);
+	lsta = STA_TO_LSTA(ltxq->txq.sta);
+	pending = atomic_load_int(&lsta->aql_pending[ltxq->txq.ac]);
+	if (pending < LKPI_AQL_LIMIT_LOW)
+		return (true);
+	return (atomic_load_int(&lhw->aql_total) < LKPI_AQL_THRESHOLD &&
+	    pending < LKPI_AQL_LIMIT_HIGH);
+}
