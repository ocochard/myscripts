From 1db12fa92fb43d8390e8759acd637d113f8d60ce Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Sat, 21 Nov 2026 21:23:41 +0100
Subject: [PATCH 1/2] linuxkpi: Honor the pgprot argument of vmap()

vmap() ignored prot, so pgprot_writecombine() callers got a cached
mapping.  On Meteor Lake the i915 media GT does not snoop the CPU
caches and its GuC rejects the firmware read through such a mapping.

Apply a non-default cache mode with pmap_change_attr(), and restore
each page's own attribute in vunmap().

Tested on Meteor Lake (i915 media GT, VA-API) and Strix Halo (amdgpu).
---
 sys/compat/linuxkpi/common/src/linux_page.c | 66 ++++++++++++++++++++-
 1 file changed, 64 insertions(+), 2 deletions(-)

diff --git a/sys/compat/linuxkpi/common/src/linux_page.c b/sys/compat/linuxkpi/common/src/linux_page.c
index a95d86753985..5f6ff1eab6f5 100644
--- a/sys/compat/linuxkpi/common/src/linux_page.c
+++ b/sys/compat/linuxkpi/common/src/linux_page.c
@@ -336,6 +336,7 @@ struct vmmap {
 	LIST_ENTRY(vmmap)	vm_next;
 	void			*vm_addr;
 	unsigned long		vm_size;
+	vm_memattr_t		vm_attr;
 };
 
 struct vmmaphd {
@@ -363,7 +364,7 @@ is_vmalloc_addr(const void *addr)
 	return (vtoslab((vm_offset_t)addr & ~UMA_SLAB_MASK) != NULL);
 }
 
-static void
+static struct vmmap *
 vmmap_add(void *addr, unsigned long size)
 {
 	struct vmmap *vmmap;
@@ -372,8 +373,11 @@ vmmap_add(void *addr, unsigned long size)
 	mtx_lock(&vmmaplock);
 	vmmap->vm_size = size;
 	vmmap->vm_addr = addr;
+	vmmap->vm_attr = VM_MEMATTR_DEFAULT;
 	LIST_INSERT_HEAD(&vmmaphead[VM_HASH(addr)], vmmap, vm_next);
 	mtx_unlock(&vmmaplock);
+
+	return (vmmap);
 }
 
 static struct vmmap *
@@ -450,19 +454,73 @@ linuxkpi_devm_memremap(struct device *dev, resource_size_t offset, size_t size,
 	return (addr);
 }
 
+#if defined(__i386__) || defined(__amd64__) || defined(__powerpc__) || defined(__aarch64__) || defined(__riscv)
+/*
+ * Give the pages of a vmap() mapping back their own memory attribute, one
+ * pmap_change_attr() call per run of pages that share it.
+ */
+static void
+vunmap_restore_attr(void *addr, size_t size)
+{
+	vm_page_t m;
+	vm_memattr_t attr, run_attr;
+	char *end, *run, *va;
+
+	end = (char *)addr + size;
+	run = addr;
+	attr = run_attr = VM_MEMATTR_DEFAULT;
+	for (va = addr; va <= end; va += PAGE_SIZE) {
+		if (va < end) {
+			m = PHYS_TO_VM_PAGE(pmap_kextract((vm_offset_t)va));
+			attr = m != NULL ? pmap_page_get_memattr(m) :
+			    VM_MEMATTR_DEFAULT;
+			if (va == addr)
+				run_attr = attr;
+			if (attr == run_attr)
+				continue;
+		}
+		if (pmap_change_attr(run, va - run, run_attr) != 0)
+			printf("linuxkpi: vunmap: cannot restore memory "
+			    "attribute of %p-%p\n", run, va);
+		run = va;
+		run_attr = attr;
+	}
+}
+#endif
+
 void *
 vmap(struct page **pages, unsigned int count, unsigned long flags, int prot)
 {
+	struct vmmap *vmmap;
 	void *off;
 	size_t size;
+	vm_memattr_t attr __unused;
 
 	size = count * PAGE_SIZE;
 	off = kva_alloc(size);
 	if (off == NULL)
 		return (NULL);
-	vmmap_add(off, size);
+	vmmap = vmmap_add(off, size);
 	pmap_qenter(off, pages, count);
 
+#if defined(__i386__) || defined(__amd64__) || defined(__powerpc__) || defined(__aarch64__) || defined(__riscv)
+	/*
+	 * pmap_qenter() maps each page with its own memory attribute.  Apply
+	 * the one the caller asked for, e.g. with pgprot_writecombine().
+	 * Unlike Linux, pmap_change_attr() also changes the direct map alias
+	 * of the pages, until vunmap().  Record the attribute first, so that
+	 * vunmap() also undoes a partial change.
+	 */
+	attr = pgprot2cachemode(prot);
+	if (attr != VM_MEMATTR_DEFAULT) {
+		vmmap->vm_attr = attr;
+		if (pmap_change_attr(off, size, attr) != 0) {
+			vunmap(off);
+			return (NULL);
+		}
+	}
+#endif
+
 	return (off);
 }
 
@@ -530,6 +588,10 @@ vunmap(void *addr)
 	vmmap = vmmap_remove(addr);
 	if (vmmap == NULL)
 		return;
+#if defined(__i386__) || defined(__amd64__) || defined(__powerpc__) || defined(__aarch64__) || defined(__riscv)
+	if (vmmap->vm_attr != VM_MEMATTR_DEFAULT)
+		vunmap_restore_attr(addr, vmmap->vm_size);
+#endif
 	pmap_qremove(addr, vmmap->vm_size / PAGE_SIZE);
 	kva_free(addr, vmmap->vm_size);
 	kfree(vmmap);
-- 
2.56.0


From e91ac9eb85d3fa978d1868922e45a5e3cb61ea84 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Fri, 27 Nov 2026 21:40:02 +0100
Subject: [PATCH 2/2] __FreeBSD_version: Bump for LinuxKPI vmap() honoring
 pgprot

drm-kmod uses it to enable the Meteor Lake media GT, which needs
write-combined vmap() mappings.
---
 sys/sys/param.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sys/sys/param.h b/sys/sys/param.h
index 467581018cd0..a91dffa99538 100644
--- a/sys/sys/param.h
+++ b/sys/sys/param.h
@@ -74,7 +74,7 @@
  * cannot include sys/param.h and should only be updated here.
  */
 #undef __FreeBSD_version
-#define __FreeBSD_version 1600032
+#define __FreeBSD_version 1600033
 
 /*
  * __FreeBSD_kernel__ indicates that this system uses the kernel of FreeBSD,
-- 
2.56.0

