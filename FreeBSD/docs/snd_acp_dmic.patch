+/*
+ * Capture from the digital microphones on the PDM interface of the AMD
+ * ACP, a pcm child of the per-generation PCI driver.  The register
+ * programming follows the Linux driver in sound/soc/amd/ps.
+ */
+
+#include <sys/param.h>
+#include <sys/bus.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/module.h>
+#include <sys/mutex.h>
+
+#include <machine/bus.h>
+
+#include <dev/sound/pcm/sound.h>
+#include <dev/sound/pci/acp.h>
+
+#include "mixer_if.h"
+
+static uint32_t acp_pdm_fmt[] = {
+	SND_FORMAT(AFMT_S32_LE, 2, 0),
+	0
+};
+
+static struct pcmchan_caps acp_pdm_caps = {
+	ACP_PDM_RATE, ACP_PDM_RATE, acp_pdm_fmt, 0
+};
+
+/* Wait until (register & mask) == want; 0 on success. */
+static int
+acp_pdm_poll(struct acp_pdm_pcminfo *scp, bus_size_t reg, uint32_t mask,
+    uint32_t want)
+{
+	int retries;
+
+	for (retries = 0; retries < ACP_COUNTER; retries++) {
+		if ((reg_read(scp, reg) & mask) == want)
+			return (0);
+		DELAY(5);
+	}
+	return (ETIMEDOUT);
+}
+
+/* 64-bit count of the bytes the PDM DMA wrote since the ACP was reset. */
+static uint64_t
+acp_pdm_get_byte_count(struct acp_pdm_pcminfo *scp)
+{
+	uint32_t hi, lo;
+
+	do {
+		hi = reg_read(scp, ACP_WOV_RX_LINEARPOSITIONCNTR_HIGH);
+		lo = reg_read(scp, ACP_WOV_RX_LINEARPOSITIONCNTR_LOW);
+	} while (hi != reg_read(scp, ACP_WOV_RX_LINEARPOSITIONCNTR_HIGH));
+	return (((uint64_t)hi << 32) | lo);
+}
+
+static void
+acp_pdm_set_gain(struct acp_pdm_pcminfo *scp)
+{
+	uint32_t value;
+
+	mtx_assert(&scp->lock, MA_OWNED);
+	value = reg_read(scp, ACP_WOV_MISC_CTRL) & ~ACP_WOV_GAIN_CONTROL;
+	reg_write(scp, ACP_WOV_MISC_CTRL,
+	    value | scp->gain << ACP_WOV_GAIN_SHIFT);
+}
+
+static void
+acp_pdm_stop(struct acp_pdm_pcminfo *scp)
+{
+	mtx_assert(&scp->lock, MA_OWNED);
+	/* Also after a start that timed out: a late DMA must not run. */
+	if ((reg_read(scp, ACP_WOV_PDM_DMA_ENABLE) & 0x01) != 0) {
+		reg_write(scp, ACP_WOV_PDM_DMA_ENABLE, 0x02);
+		if (acp_pdm_poll(scp, ACP_WOV_PDM_DMA_ENABLE,
+		    ACP_PDM_DMA_EN_STATUS, 0) != 0)
+			device_printf(scp->dev, "PDM DMA did not stop\n");
+	}
+	reg_write(scp, ACP_WOV_PDM_ENABLE, ACP_PDM_DISABLE);
+	reg_write(scp, ACP_WOV_PDM_FIFO_FLUSH, 0x01);
+	reg_write(scp, ACP_EXTERNAL_INTR_CNTL,
+	    reg_read(scp, ACP_EXTERNAL_INTR_CNTL) & ~PDM_DMA_INTR_MASK);
+	scp->rch.run = false;
+}
+
+static int
+acp_pdm_start(struct acp_pdm_pcminfo *scp)
+{
+	struct acp_pdm_chinfo *ch = &scp->rch;
+	bus_addr_t addr;
+	u_int i, npages;
+
+	mtx_assert(&scp->lock, MA_OWNED);
+	/* Page table: one entry per 4 KB page of the (contiguous) ring. */
+	addr = ch->buffer->buf_addr;
+	npages = ch->buffer->bufsize / PAGE_SIZE;
+	for (i = 0; i < npages; i++, addr += PAGE_SIZE) {
+		reg_write(scp, ACP_SCRATCH_REG_0 + i * 8, (uint32_t)addr);
+		reg_write(scp, ACP_SCRATCH_REG_0 + i * 8 + 4,
+		    (uint32_t)(addr >> 32) | (1U << 31));
+	}
+	reg_write(scp, ACPAXI2AXI_ATU_BASE_ADDR_GRP_1,
+	    ACP_SRAM_PTE_OFFSET | (1U << 31));
+	reg_write(scp, ACPAXI2AXI_ATU_PAGE_SIZE_GRP_1, PAGE_SIZE_4K_ENABLE);
+
+	reg_write(scp, ACP_WOV_RX_RINGBUFADDR, PDM_MEM_WINDOW_START);
+	reg_write(scp, ACP_WOV_RX_RINGBUFSIZE, ch->buffer->bufsize);
+	reg_write(scp, ACP_WOV_RX_INTR_WATERMARK_SIZE, ch->blksz);
+	reg_write(scp, ACPAXI2AXI_ATU_CTRL, 0x01);
+
+	reg_write(scp, ACP_EXTERNAL_INTR_CNTL,
+	    reg_read(scp, ACP_EXTERNAL_INTR_CNTL) | PDM_DMA_INTR_MASK);
+	reg_write(scp, ACP_WOV_PDM_NO_OF_CHANNELS, 0x00);
+	reg_write(scp, ACP_WOV_PDM_DECIMATION_FACTOR, PDM_DECIMATION_FACTOR);
+	reg_write(scp, ACP_WOV_CLK_CTRL, ACP_PDM_CLK_FREQ_MASK);
+	acp_pdm_set_gain(scp);
+
+	/* The count goes on across recordings; the DMA restarts at 0. */
+	ch->start_bytecnt = acp_pdm_get_byte_count(scp);
+	reg_write(scp, ACP_WOV_PDM_ENABLE, ACP_PDM_ENABLE);
+	reg_write(scp, ACP_WOV_PDM_DMA_ENABLE, 0x01);
+	ch->run = true;
+	if (acp_pdm_poll(scp, ACP_WOV_PDM_DMA_ENABLE, ACP_PDM_DMA_EN_STATUS,
+	    ACP_PDM_DMA_EN_STATUS) != 0) {
+		device_printf(scp->dev, "PDM DMA did not start\n");
+		acp_pdm_stop(scp);
+		return (EIO);
+	}
+	return (0);
+}
+
+/* Called by the PCI driver's interrupt handler on a PDM period. */
+static void
+acp_pdm_intr(struct acp_pdm_pcminfo *scp)
+{
+	bool run;
+
+	mtx_lock(&scp->lock);
+	run = scp->rch.run;
+	mtx_unlock(&scp->lock);
+	/* chn_intr() takes the channel lock, which ranks above ours. */
+	if (run)
+		chn_intr(scp->rch.channel);
+}
+
+/* Mixer interface. */
+
+static int
+acp_pdm_mixer_init(struct snd_mixer *m)
+{
+	mix_setdevs(m, SOUND_MASK_IGAIN);
+	mix_setrecdevs(m, SOUND_MASK_IGAIN);
+	return (0);
+}
+
+static int
+acp_pdm_mixer_set(struct snd_mixer *m, unsigned dev, unsigned left,
+    unsigned right)
+{
+	struct acp_pdm_pcminfo *scp = mix_getdevinfo(m);
+
+	if (dev != SOUND_MIXER_IGAIN)
+		return (-1);
+	/*
+	 * Not the channel lock: mixer_uninit() sets every control after
+	 * pcm_unregister() freed the channels.
+	 */
+	mtx_lock(&scp->lock);
+	scp->gain = (left + right) * ACP_PDM_MAX_GAIN / (2 * 100);
+	if (scp->rch.run)
+		acp_pdm_set_gain(scp);
+	mtx_unlock(&scp->lock);
+	return (0);
+}
+
+static kobj_method_t acp_pdm_mixer_methods[] = {
+	KOBJMETHOD(mixer_init,	acp_pdm_mixer_init),
+	KOBJMETHOD(mixer_set,	acp_pdm_mixer_set),
+	KOBJMETHOD_END
+};
+MIXER_DECLARE(acp_pdm_mixer);
+
+/* Channel interface. */
+
+static void *
+acp_pdm_chan_init(kobj_t obj, void *devinfo, struct snd_dbuf *b,
+    struct pcm_channel *c, int dir)
+{
+	struct acp_pdm_pcminfo *scp = devinfo;
+	struct acp_pdm_chinfo *ch = &scp->rch;
+
+	if (dir != PCMDIR_REC)
+		return (NULL);
+	ch->parent = scp;
+	ch->buffer = b;
+	ch->channel = c;
+	ch->blksz = ACP_PDM_BLKSZ_DEFAULT;
+	if (sndbuf_alloc(b, scp->dmat, 0, ACP_PDM_BUFSZ) != 0)
+		return (NULL);
+	if (sndbuf_resize(b, ACP_PDM_BUFSZ / ch->blksz, ch->blksz) != 0)
+		return (NULL);
+	return (ch);
+}
+
+static int
+acp_pdm_chan_setformat(kobj_t obj, void *data, uint32_t format)
+{
+	return (format == acp_pdm_fmt[0] ? 0 : EINVAL);
+}
+
+static uint32_t
+acp_pdm_chan_setspeed(kobj_t obj, void *data, uint32_t speed)
+{
+	return (ACP_PDM_RATE);
+}
+
+/* The ring stays 64 KB; a block is a power of two from 4 KB to 32 KB. */
+static uint32_t
+acp_pdm_chan_setblocksize(kobj_t obj, void *data, uint32_t blksz)
+{
+	struct acp_pdm_chinfo *ch = data;
+
+	blksz = MIN(MAX(blksz, ACP_PDM_BLKSZ_MIN), ACP_PDM_BLKSZ_MAX);
+	blksz = 1U << (fls(blksz) - 1);
+	if (!ch->run && sndbuf_resize(ch->buffer, ACP_PDM_BUFSZ / blksz,
+	    blksz) == 0)
+		ch->blksz = blksz;
+	return (ch->blksz);
+}
+
+static int
+acp_pdm_chan_trigger(kobj_t obj, void *data, int go)
+{
+	struct acp_pdm_chinfo *ch = data;
+	struct acp_pdm_pcminfo *scp = ch->parent;
+	int error = 0;
+
+	if (!PCMTRIG_COMMON(go))
+		return (0);
+	mtx_lock(&scp->lock);
+	if (go == PCMTRIG_START && !ch->run)
+		error = acp_pdm_start(scp);
+	else if (go != PCMTRIG_START && ch->run)
+		acp_pdm_stop(scp);
+	mtx_unlock(&scp->lock);
+	return (error);
+}
+
+/*
+ * The ACP counts every byte its PDM DMA writes, and the DMA restarts at the
+ * start of the ring on START: the pointer is the count since START, modulo
+ * the ring size, rounded down to a whole frame.
+ */
+static uint32_t
+acp_pdm_chan_getptr(kobj_t obj, void *data)
+{
+	struct acp_pdm_chinfo *ch = data;
+	struct acp_pdm_pcminfo *scp = ch->parent;
+	uint64_t pos;
+
+	mtx_lock(&scp->lock);
+	pos = (acp_pdm_get_byte_count(scp) - ch->start_bytecnt) & ~7ULL;
+	mtx_unlock(&scp->lock);
+	return ((uint32_t)(pos % ch->buffer->bufsize));
+}
+
+static struct pcmchan_caps *
+acp_pdm_chan_getcaps(kobj_t obj, void *data)
+{
+	return (&acp_pdm_caps);
+}
+
+static kobj_method_t acp_pdm_chan_methods[] = {
+	KOBJMETHOD(channel_init,	 acp_pdm_chan_init),
+	KOBJMETHOD(channel_setformat,	 acp_pdm_chan_setformat),
+	KOBJMETHOD(channel_setspeed,	 acp_pdm_chan_setspeed),
+	KOBJMETHOD(channel_setblocksize, acp_pdm_chan_setblocksize),
+	KOBJMETHOD(channel_trigger,	 acp_pdm_chan_trigger),
+	KOBJMETHOD(channel_getptr,	 acp_pdm_chan_getptr),
+	KOBJMETHOD(channel_getcaps,	 acp_pdm_chan_getcaps),
+	KOBJMETHOD_END
+};
+CHANNEL_DECLARE(acp_pdm_chan);
+
+/* Device interface. */
+
+static int
+acp_pdm_probe(device_t dev)
+{
+	device_set_desc(dev, "AMD ACP digital microphones");
+	return (BUS_PROBE_SPECIFIC);
+}
+
+static int
+acp_pdm_attach(device_t dev)
+{
+	struct acp_pdm_pcminfo *scp = device_get_ivars(dev);
+	struct snddev_info *d = device_get_softc(dev);
+	char status[SND_STATUSLEN];
+
+	mtx_init(&scp->lock, device_get_nameunit(dev), "snd_acp_pdm", MTX_DEF);
+	if (bus_dma_tag_create(bus_get_dma_tag(dev), PAGE_SIZE, 0,
+	    BUS_SPACE_MAXADDR_32BIT, BUS_SPACE_MAXADDR, NULL, NULL,
+	    ACP_PDM_BUFSZ, 1, ACP_PDM_BUFSZ, 0, NULL, NULL, &scp->dmat) != 0) {
+		device_printf(dev, "cannot create DMA tag\n");
+		mtx_destroy(&scp->lock);
+		return (ENXIO);
+	}
+
+	/* The PCI driver's interrupt handler, not snd_setup_intr(). */
+	pcm_setflags(dev, pcm_getflags(dev) | SD_F_MPSAFE);
+	pcm_init(dev, scp);
+	/* Before pcm_register(), which creates the mixer device. */
+	if (mixer_init(dev, &acp_pdm_mixer_class, scp) != 0)
+		device_printf(dev, "cannot set up the mixer\n");
+	else
+		mix_set(d->mixer, SOUND_MIXER_IGAIN, 100, 100);
+	if (pcm_addchan(dev, PCMDIR_REC, &acp_pdm_chan_class, scp) != 0) {
+		device_printf(dev, "cannot add the recording channel\n");
+		goto bad;
+	}
+	snprintf(status, SND_STATUSLEN, "on %s",
+	    device_get_nameunit(device_get_parent(dev)));
+	if (pcm_register(dev, status) != 0)
+		goto bad;
+	scp->ih = acp_pdm_intr;
+	return (0);
+
+bad:
+	pcm_unregister(dev);
+	bus_dma_tag_destroy(scp->dmat);
+	mtx_destroy(&scp->lock);
+	return (ENXIO);
+}
+
+static int
+acp_pdm_detach(device_t dev)
+{
+	struct acp_pdm_pcminfo *scp = device_get_ivars(dev);
+	int error;
+
+	/* acp_pdm_intr() may still run: detach the PCI device instead. */
+	if (!scp->intr_gone)
+		return (EBUSY);
+	mtx_lock(&scp->lock);
+	if (scp->rch.run)
+		acp_pdm_stop(scp);
+	mtx_unlock(&scp->lock);
+	if ((error = pcm_unregister(dev)) != 0)
+		return (error);
+	scp->ih = NULL;
+	bus_dma_tag_destroy(scp->dmat);
+	mtx_destroy(&scp->lock);
+	return (0);
+}
+
+/* The PCI driver resets the ACP after this and before resume. */
+static int
+acp_pdm_suspend(device_t dev)
+{
+	struct acp_pdm_pcminfo *scp = device_get_ivars(dev);
+
+	mtx_lock(&scp->lock);
+	scp->rch.resume = scp->rch.run;
+	if (scp->rch.run)
+		acp_pdm_stop(scp);
+	mtx_unlock(&scp->lock);
+	return (0);
+}
+
+static int
+acp_pdm_resume(device_t dev)
+{
+	struct acp_pdm_pcminfo *scp = device_get_ivars(dev);
+	struct snd_dbuf *b = scp->rch.buffer;
+
+	mtx_lock(&scp->lock);
+	if (scp->rch.resume) {
+		/*
+		 * The DMA restarts at offset 0 while pcm(4) keeps its read
+		 * pointer: what pcm(4) reads before catching up is silence,
+		 * not the audio recorded before the suspend.
+		 */
+		bzero(b->buf, b->bufsize);
+		bus_dmamap_sync(b->dmatag, b->dmamap, BUS_DMASYNC_PREREAD);
+		(void)acp_pdm_start(scp);
+	}
+	scp->rch.resume = false;
+	mtx_unlock(&scp->lock);
+	return (0);
+}
+
+static device_method_t acp_pdm_methods[] = {
+	DEVMETHOD(device_probe,		acp_pdm_probe),
+	DEVMETHOD(device_attach,	acp_pdm_attach),
+	DEVMETHOD(device_detach,	acp_pdm_detach),
+	DEVMETHOD(device_suspend,	acp_pdm_suspend),
+	DEVMETHOD(device_resume,	acp_pdm_resume),
+	DEVMETHOD_END
+};
+
+static driver_t acp_pdm_driver = {
+	"pcm",
+	acp_pdm_methods,
+	PCM_SOFTC_SIZE,
+};
+
+DRIVER_MODULE(snd_acp_pdm, acp70, acp_pdm_driver, 0, 0);
+MODULE_DEPEND(snd_acp_pdm, sound, 1, 1, 1);
+MODULE_VERSION(snd_acp_pdm, 1);
