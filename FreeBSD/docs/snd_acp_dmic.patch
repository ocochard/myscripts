From ff58c180e2e6eebaf9eb039d77e784053782869a Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Tue, 17 Nov 2026 00:40:52 +0100
Subject: [PATCH 2/3] snd_acp: Mute the start burst and remove the DC offset

The PDM microphones start each recording with about 60 ms of
full-scale noise, then carry a DC offset (-22 dBFS on channel 0 of an
HP ZBook Ultra G1a).  Mute the first 100 ms and remove the offset with
a high-pass at about 7.5 Hz, skipped when dev.pcm.N.bitperfect is set.
---
 share/man/man4/snd_acp.4 |  7 +++++-
 sys/dev/sound/pci/acp.c  | 54 ++++++++++++++++++++++++++++++++++++++--
 2 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/share/man/man4/snd_acp.4 b/share/man/man4/snd_acp.4
index 61f85015ab08..91dfef40354a 100644
--- a/share/man/man4/snd_acp.4
+++ b/share/man/man4/snd_acp.4
@@ -56,6 +56,12 @@ It provides one recording channel, stereo, 32-bit signed little-endian
 samples at 48 kHz; the
 .Xr sound 4
 feeders convert to other formats and rates.
+The driver removes the DC offset that the microphones carry with a
+high-pass filter at about 7.5 Hz, unless
+.Va dev.pcm.%d.bitperfect
+is set.
+The first 100 ms of each recording are muted: the microphones start
+with a full-scale burst.
 .Pp
 The driver attaches only when the firmware reports digital microphones:
 the ACP pin configuration must route the PDM interface, and the ACPI
@@ -83,4 +89,3 @@ driver first appeared in
 .An Olivier Cochard Aq Mt olivier@FreeBSD.org
 .Sh BUGS
 The microphones' gain cannot be changed; there is no mixer.
-Recordings carry a DC offset that the driver does not remove.
diff --git a/sys/dev/sound/pci/acp.c b/sys/dev/sound/pci/acp.c
index b2f133dcc598..aa0f8a945cd8 100644
--- a/sys/dev/sound/pci/acp.c
+++ b/sys/dev/sound/pci/acp.c
@@ -108,6 +108,8 @@
 #define	ACP_RATE		48000
 #define	ACP_POLL_US		5
 #define	ACP_TIMEOUT_US		500
+#define	ACP_DC_SHIFT		10	/* high-pass at about 7.5 Hz */
+#define	ACP_MUTE_BYTES		(ACP_RATE / 10 * 8)	/* first 100 ms */
 
 struct acp_info;
 
@@ -116,6 +118,8 @@ struct acp_chinfo {
 	struct pcm_channel	*channel;
 	struct acp_info		*parent;
 	uint64_t		start_pos;
+	uint64_t		hpos;	/* bytes since start, processed */
+	int64_t			dc[2];	/* DC estimate per channel, Q10 */
 	uint32_t		blksz;
 	bool			running;
 };
@@ -271,6 +275,7 @@ acp_pdm_start(struct acp_info *sc, struct acp_chinfo *ch)
 	acp_wr(sc, ACP_ATU_CTRL, 1);
 
 	ch->start_pos = acp_pdm_pos(sc);
+	ch->hpos = 0;
 	acp_wr(sc, ACP_PDM_ENABLE, 1);
 	acp_wr(sc, ACP_PDM_DMA_ENABLE, 1);
 	if (acp_poll(sc, ACP_PDM_DMA_ENABLE, ACP_PDM_DMA_RUNNING,
@@ -376,6 +381,50 @@ acpchan_trigger(kobj_t obj, void *data, int go)
 	return (0);
 }
 
+/*
+ * Process the samples that arrived since the last call, in place: mute
+ * the first 100 ms (the microphones start with a full-scale burst), then
+ * remove their DC offset with a first-order high-pass, y = x - mean, the
+ * mean being a running average over 2^ACP_DC_SHIFT samples.
+ */
+static void
+acp_rec_process(struct acp_info *sc, struct acp_chinfo *ch, uint64_t end)
+{
+	struct snd_dbuf *b = ch->buffer;
+	int32_t *s = (int32_t *)b->buf;
+	int32_t *p;
+	int64_t y;
+	uint64_t k;
+	int c;
+	bool filter;
+
+	/* bitperfect asks for the samples unprocessed, DC offset included. */
+	filter = (pcm_getflags(sc->dev) & SD_F_BITPERFECT) == 0;
+	if (end - ch->hpos > b->bufsize)
+		ch->hpos = end - b->bufsize;	/* overrun */
+	if (!filter && ch->hpos >= ACP_MUTE_BYTES)
+		ch->hpos = end;
+	if (ch->hpos == end)
+		return;
+	bus_dmamap_sync(b->dmatag, b->dmamap, BUS_DMASYNC_POSTREAD);
+	for (k = ch->hpos; k < end; k += 4) {
+		p = &s[(k % b->bufsize) / 4];
+		c = (k / 4) & 1;
+		if (k < ACP_MUTE_BYTES) {
+			*p = 0;
+			continue;
+		}
+		if (k < ACP_MUTE_BYTES + 8)
+			ch->dc[c] = (int64_t)*p << ACP_DC_SHIFT;
+		if (!filter)
+			continue;
+		ch->dc[c] += *p - (ch->dc[c] >> ACP_DC_SHIFT);
+		y = *p - (ch->dc[c] >> ACP_DC_SHIFT);
+		*p = MIN(MAX(y, INT32_MIN), INT32_MAX);
+	}
+	ch->hpos = end;
+}
+
 /*
  * The ACP counts every byte its PDM DMA writes, and the DMA restarts at the
  * start of the ring on START: the pointer is the count since START, modulo
@@ -389,9 +438,10 @@ acpchan_getptr(kobj_t obj, void *data)
 	uint64_t pos;
 
 	mtx_lock(&sc->lock);
-	pos = acp_pdm_pos(sc) - ch->start_pos;
+	pos = (acp_pdm_pos(sc) - ch->start_pos) & ~7ULL;
+	acp_rec_process(sc, ch, pos);
 	mtx_unlock(&sc->lock);
-	return ((uint32_t)(pos % ch->buffer->bufsize) & ~7U);
+	return ((uint32_t)(pos % ch->buffer->bufsize));
 }
 
 static struct pcmchan_caps *
-- 
