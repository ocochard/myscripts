From b64e7aaeeb559f05e94973d7b8cb67135a692bc9 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Thu, 26 Nov 2026 21:00:06 +0100
Subject: [PATCH 3/3] snd_acp_pdm: Set the microphone gain with the recording
 level

The PDM block has a 2-bit gain, bits 4:3 of ACP_WOV_MISC_CTRL, that the
igain control set.  Each step is 6 dB: a 440 Hz tone recorded at -85,
-79, -73 and -67 dBFS on an HP ZBook Ultra G1a.  Linux sets it from the
pdm_gain module parameter, default 3, without a mixer control.

Expose it as the mixer's recording level instead, one step per 25; the
default level, 75, keeps the maximum gain.  Level 0, which mixer(8)
also sets to mute, silences the samples: the lowest gain still records.

Reviewed by:	christos, wulf
Pull Request:	https://ron-dev.freebsd.org/FreeBSD/src/pulls/124
---
 share/man/man4/snd_acp70.4  | 11 ++++++---
 sys/dev/sound/pci/acp-pdm.c | 49 +++++++++++++++++++++++++++----------
 sys/dev/sound/pci/acp.h     |  1 +
 3 files changed, 44 insertions(+), 17 deletions(-)

diff --git a/share/man/man4/snd_acp70.4 b/share/man/man4/snd_acp70.4
index e2cb3fdce261..05312c90f49d 100644
--- a/share/man/man4/snd_acp70.4
+++ b/share/man/man4/snd_acp70.4
@@ -68,10 +68,13 @@ with a full-scale burst.
 .Pp
 The
 .Xr mixer 8
-input gain
-.Pq Cm igain
-sets the microphones' gain in four steps of about 6 dB; the default, 100,
-is the highest.
+recording level
+.Pq Cm rec
+sets the microphones' gain in four steps of about 6 dB: 1 to 24 is
+the lowest, 75 to 100 the highest, which is the default.
+Level 0, or muting
+.Cm rec ,
+silences the recording.
 .Pp
 The driver attaches only when the firmware reports digital microphones:
 the ACP pin configuration must route the PDM interface, the ACPI node at
diff --git a/sys/dev/sound/pci/acp-pdm.c b/sys/dev/sound/pci/acp-pdm.c
index 3c25b3115da9..3e636141b172 100644
--- a/sys/dev/sound/pci/acp-pdm.c
+++ b/sys/dev/sound/pci/acp-pdm.c
@@ -177,13 +177,17 @@ acp_pdm_intr(struct acp_pdm_pcminfo *scp)
 		chn_intr(scp->rch.channel);
 }
 
-/* Mixer interface. */
+/*
+ * Mixer interface.  The recording level sets the PDM gain: 1-24 is gain 0,
+ * then one step per 25, and 0 mutes.  The default level, 75, keeps the
+ * maximum gain, as Linux does.
+ */
 
 static int
 acp_pdm_mixer_init(struct snd_mixer *m)
 {
-	mix_setdevs(m, SOUND_MASK_IGAIN);
-	mix_setrecdevs(m, SOUND_MASK_IGAIN);
+	mix_setdevs(m, SOUND_MASK_RECLEV);
+	mix_setrecdevs(m, SOUND_MASK_RECLEV);
 	return (0);
 }
 
@@ -192,24 +196,45 @@ acp_pdm_mixer_set(struct snd_mixer *m, unsigned dev, unsigned left,
     unsigned right)
 {
 	struct acp_pdm_pcminfo *scp = mix_getdevinfo(m);
+	struct acp_pdm_chinfo *ch = &scp->rch;
+	u_int level, gain;
+	int c;
 
-	if (dev != SOUND_MIXER_IGAIN)
+	if (dev != SOUND_MIXER_RECLEV)
 		return (-1);
+	level = MAX(left, right);
+	gain = MIN(level / 25, ACP_PDM_MAX_GAIN);
 	/*
 	 * Not the channel lock: mixer_uninit() sets every control after
 	 * pcm_unregister() freed the channels.
 	 */
 	mtx_lock(&scp->lock);
-	scp->gain = (left + right) * ACP_PDM_MAX_GAIN / (2 * 100);
-	if (scp->rch.run)
+	/* Level 0 mutes: the lowest gain is still 18 dB under the default. */
+	scp->muted = level == 0;
+	if (ch->run && gain != scp->gain) {
+		/* The offset scales with the gain: keep the filter settled. */
+		for (c = 0; c < 2; c++)
+			ch->dc[c] = gain > scp->gain ?
+			    ch->dc[c] << (gain - scp->gain) :
+			    ch->dc[c] >> (scp->gain - gain);
+	}
+	scp->gain = gain;
+	if (ch->run)
 		acp_pdm_set_gain(scp);
 	mtx_unlock(&scp->lock);
 	return (0);
 }
 
+static uint32_t
+acp_pdm_mixer_setrecsrc(struct snd_mixer *m, uint32_t src)
+{
+	return (SOUND_MASK_RECLEV);
+}
+
 static kobj_method_t acp_pdm_mixer_methods[] = {
-	KOBJMETHOD(mixer_init,	acp_pdm_mixer_init),
-	KOBJMETHOD(mixer_set,	acp_pdm_mixer_set),
+	KOBJMETHOD(mixer_init,		acp_pdm_mixer_init),
+	KOBJMETHOD(mixer_set,		acp_pdm_mixer_set),
+	KOBJMETHOD(mixer_setrecsrc,	acp_pdm_mixer_setrecsrc),
 	KOBJMETHOD_END
 };
 MIXER_DECLARE(acp_pdm_mixer);
@@ -302,7 +327,7 @@ acp_pdm_rec_process(struct acp_pdm_pcminfo *scp, struct acp_pdm_chinfo *ch,
 	filter = (pcm_getflags(scp->dev) & SD_F_BITPERFECT) == 0;
 	if (end - ch->hpos > b->bufsize)
 		ch->hpos = end - b->bufsize;	/* overrun */
-	if (!filter && ch->hpos >= ACP_PDM_MUTE_BYTES)
+	if (!filter && !scp->muted && ch->hpos >= ACP_PDM_MUTE_BYTES)
 		ch->hpos = end;
 	if (ch->hpos == end)
 		return;
@@ -310,7 +335,7 @@ acp_pdm_rec_process(struct acp_pdm_pcminfo *scp, struct acp_pdm_chinfo *ch,
 	for (k = ch->hpos; k < end; k += 4) {
 		p = &s[(k % b->bufsize) / 4];
 		c = (k / 4) & 1;
-		if (k < ACP_PDM_MUTE_BYTES) {
+		if (k < ACP_PDM_MUTE_BYTES || scp->muted) {
 			*p = 0;
 			continue;
 		}
@@ -378,7 +403,6 @@ static int
 acp_pdm_attach(device_t dev)
 {
 	struct acp_pdm_pcminfo *scp = device_get_ivars(dev);
-	struct snddev_info *d = device_get_softc(dev);
 	char status[SND_STATUSLEN];
 
 	mtx_init(&scp->lock, device_get_nameunit(dev), "snd_acp_pdm", MTX_DEF);
@@ -392,12 +416,11 @@ acp_pdm_attach(device_t dev)
 
 	/* The PCI driver's interrupt handler, not snd_setup_intr(). */
 	pcm_setflags(dev, pcm_getflags(dev) | SD_F_MPSAFE);
+	scp->gain = ACP_PDM_MAX_GAIN;
 	pcm_init(dev, scp);
 	/* Before pcm_register(), which creates the mixer device. */
 	if (mixer_init(dev, &acp_pdm_mixer_class, scp) != 0)
 		device_printf(dev, "cannot set up the mixer\n");
-	else
-		mix_set(d->mixer, SOUND_MIXER_IGAIN, 100, 100);
 	if (pcm_addchan(dev, PCMDIR_REC, &acp_pdm_chan_class, scp) != 0) {
 		device_printf(dev, "cannot add the recording channel\n");
 		goto bad;
