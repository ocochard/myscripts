From 02497907dec578cee2798392524bf2fdf3a491e6 Mon Sep 17 00:00:00 2001
From: Olivier Cochard <olivier@FreeBSD.org>
Date: Thu, 26 Nov 2026 20:59:30 +0100
Subject: [PATCH 2/3] snd_acp_pdm: Mute the start burst and remove the DC
 offset

The PDM microphones start each recording with about 60 ms of
full-scale noise, then carry a DC offset (-22 dBFS on channel 0 of an
HP ZBook Ultra G1a; wulf sees one on Lenovo ThinkBooks too, which
clicks at start and stop).  Mute the first 100 ms and remove the offset
with a high-pass at about 7.5 Hz, skipped when dev.pcm.N.bitperfect is
set.

Reviewed by:	christos, wulf
Pull Request:	https://ron-dev.freebsd.org/FreeBSD/src/pulls/124
---
 share/man/man4/snd_acp70.4  |  6 +++++
 sys/dev/sound/pci/acp-pdm.c | 54 +++++++++++++++++++++++++++++++++++++
 sys/dev/sound/pci/acp.h     |  3 +++
 3 files changed, 63 insertions(+)

diff --git a/share/man/man4/snd_acp70.4 b/share/man/man4/snd_acp70.4
index f296a3e0c68f..e2cb3fdce261 100644
--- a/share/man/man4/snd_acp70.4
+++ b/share/man/man4/snd_acp70.4
@@ -59,6 +59,12 @@ It provides one recording channel, stereo, 32-bit signed little-endian
 samples at 48 kHz; the
 .Xr sound 4
 feeders convert to other formats and rates.
+The driver removes the DC offset that the microphones carry with a
+high-pass filter at about 7.5 Hz, unless
+.Va dev.pcm.%d.bitperfect
+is set.
+The first 100 ms of each recording are muted: the microphones start
+with a full-scale burst.
 .Pp
 The
 .Xr mixer 8
diff --git a/sys/dev/sound/pci/acp-pdm.c b/sys/dev/sound/pci/acp-pdm.c
index 09b5f305eb2e..3c25b3115da9 100644
--- a/sys/dev/sound/pci/acp-pdm.c
+++ b/sys/dev/sound/pci/acp-pdm.c
@@ -46,6 +46,9 @@
 
 #include "mixer_if.h"
 
+#define	ACP_PDM_DC_SHIFT	10	/* high-pass at about 7.5 Hz */
+#define	ACP_PDM_MUTE_BYTES	(ACP_PDM_RATE / 10 * 8)	/* first 100 ms */
+
 static uint32_t acp_pdm_fmt[] = {
 	SND_FORMAT(AFMT_S32_LE, 2, 0),
 	0
@@ -146,6 +149,8 @@ acp_pdm_start(struct acp_pdm_pcminfo *scp)
 
 	/* The count goes on across recordings; the DMA restarts at 0. */
 	ch->start_bytecnt = acp_pdm_get_byte_count(scp);
+	ch->hpos = 0;
+	ch->dc_set[0] = ch->dc_set[1] = false;
 	reg_write(scp, ACP_WOV_PDM_ENABLE, ACP_PDM_ENABLE);
 	reg_write(scp, ACP_WOV_PDM_DMA_ENABLE, 0x01);
 	ch->run = true;
@@ -275,6 +280,54 @@ acp_pdm_chan_trigger(kobj_t obj, void *data, int go)
 	return (error);
 }
 
+/*
+ * Process the samples that arrived since the last call, in place: mute
+ * the first 100 ms (the microphones start with a full-scale burst), then
+ * remove their DC offset with a first-order high-pass, y = x - mean, the
+ * mean being a running average over 2^ACP_PDM_DC_SHIFT samples.
+ */
+static void
+acp_pdm_rec_process(struct acp_pdm_pcminfo *scp, struct acp_pdm_chinfo *ch,
+    uint64_t end)
+{
+	struct snd_dbuf *b = ch->buffer;
+	int32_t *s = (int32_t *)b->buf;
+	int32_t *p;
+	int64_t y;
+	uint64_t k;
+	int c;
+	bool filter;
+
+	/* bitperfect asks for the samples unprocessed, DC offset included. */
+	filter = (pcm_getflags(scp->dev) & SD_F_BITPERFECT) == 0;
+	if (end - ch->hpos > b->bufsize)
+		ch->hpos = end - b->bufsize;	/* overrun */
+	if (!filter && ch->hpos >= ACP_PDM_MUTE_BYTES)
+		ch->hpos = end;
+	if (ch->hpos == end)
+		return;
+	bus_dmamap_sync(b->dmatag, b->dmamap, BUS_DMASYNC_POSTREAD);
+	for (k = ch->hpos; k < end; k += 4) {
+		p = &s[(k % b->bufsize) / 4];
+		c = (k / 4) & 1;
+		if (k < ACP_PDM_MUTE_BYTES) {
+			*p = 0;
+			continue;
+		}
+		/* From the first sample kept, even past an overrun. */
+		if (!ch->dc_set[c]) {
+			ch->dc[c] = (int64_t)*p << ACP_PDM_DC_SHIFT;
+			ch->dc_set[c] = true;
+		}
+		if (!filter)
+			continue;
+		ch->dc[c] += *p - (ch->dc[c] >> ACP_PDM_DC_SHIFT);
+		y = *p - (ch->dc[c] >> ACP_PDM_DC_SHIFT);
+		*p = MIN(MAX(y, INT32_MIN), INT32_MAX);
+	}
+	ch->hpos = end;
+}
+
 /*
  * The ACP counts every byte its PDM DMA writes, and the DMA restarts at the
  * start of the ring on START: the pointer is the count since START, modulo
@@ -289,6 +342,7 @@ acp_pdm_chan_getptr(kobj_t obj, void *data)
 
 	mtx_lock(&scp->lock);
 	pos = (acp_pdm_get_byte_count(scp) - ch->start_bytecnt) & ~7ULL;
+	acp_pdm_rec_process(scp, ch, pos);
 	mtx_unlock(&scp->lock);
 	return ((uint32_t)(pos % ch->buffer->bufsize));
 }
diff --git a/sys/dev/sound/pci/acp.h b/sys/dev/sound/pci/acp.h
index dc93e29d126e..f0561bd2b3f5 100644
--- a/sys/dev/sound/pci/acp.h
+++ b/sys/dev/sound/pci/acp.h
@@ -95,6 +95,9 @@ struct acp_pdm_chinfo {
 	struct pcm_channel	*channel;
 	struct acp_pdm_pcminfo	*parent;
 	uint64_t		start_bytecnt;
+	uint64_t		hpos;	/* bytes since start, processed */
+	int64_t			dc[2];	/* DC estimate per channel, Q10 */
+	bool			dc_set[2];	/* dc[] seeded */
 	uint32_t		blksz;
 	bool			run;
 	bool			resume;	/* was running at suspend */
-- 
