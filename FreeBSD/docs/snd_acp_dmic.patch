+
+/*
+ * AMD Audio Coprocessor (ACP): registers and the state shared between a
+ * per-generation PCI driver and the PDM capture driver, acp-pdm.c.
+ */
+
+#ifndef _DEV_SOUND_PCI_ACP_H_
+#define	_DEV_SOUND_PCI_ACP_H_
+
+#define	ACPAXI2AXI_ATU_PAGE_SIZE_GRP_1		0x0C00
+#define	ACPAXI2AXI_ATU_BASE_ADDR_GRP_1		0x0C04
+#define	ACPAXI2AXI_ATU_CTRL			0x0C40
+#define	ACP_SOFT_RESET				0x1000
+#define	ACP_CONTROL				0x1004
+#define	ACP_ZSC_DSP_CTRL			0x1014
+#define	ACP_PGFSM_CONTROL			0x1024
+#define	ACP_PGFSM_STATUS			0x1028
+#define	ACP_PIN_CONFIG				0x1440
+#define	ACP_EXTERNAL_INTR_ENB			0x1A00
+#define	ACP_EXTERNAL_INTR_CNTL			0x1A04
+#define	ACP_EXTERNAL_INTR_STAT			0x1A0C
+#define	ACP_WOV_PDM_ENABLE			0x2C04
+#define	ACP_WOV_PDM_DMA_ENABLE			0x2C08
+#define	ACP_WOV_RX_RINGBUFADDR			0x2C0C
+#define	ACP_WOV_RX_RINGBUFSIZE			0x2C10
+#define	ACP_WOV_RX_LINEARPOSITIONCNTR_HIGH	0x2C18
+#define	ACP_WOV_RX_LINEARPOSITIONCNTR_LOW	0x2C1C
+#define	ACP_WOV_RX_INTR_WATERMARK_SIZE		0x2C20
+#define	ACP_WOV_PDM_FIFO_FLUSH			0x2C24
+#define	ACP_WOV_PDM_NO_OF_CHANNELS		0x2C28
+#define	ACP_WOV_PDM_DECIMATION_FACTOR		0x2C2C
+#define	ACP_WOV_MISC_CTRL			0x2C5C
+#define	ACP_WOV_CLK_CTRL			0x2C60
+#define	ACP_SCRATCH_REG_0			0x10000
+
+#define	ACP_SOFT_RESET_SOFTRESET_AUDDONE_MASK	0x00010001
+#define	ACP_EXT_INTR_STAT_CLEAR_MASK		0xFFFFFFFF
+#define	PDM_DMA_STAT				0x10
+#define	PDM_DMA_INTR_MASK			0x10000
+
+#define	ACP_PDM_ENABLE				0x01
+#define	ACP_PDM_DISABLE				0x00
+#define	ACP_PDM_DMA_EN_STATUS			0x02
+#define	PDM_DECIMATION_FACTOR			2
+#define	ACP_PDM_CLK_FREQ_MASK			0x07
+#define	ACP_WOV_GAIN_CONTROL			0x18	/* 0 to 3, 6 dB steps */
+#define	ACP_WOV_GAIN_SHIFT			3
+#define	ACP_PDM_MAX_GAIN			3
+#define	ACP_COUNTER				20000	/* polls of 5 us */
+
+#define	ACP_SRAM_PTE_OFFSET			0x03800000
+#define	PAGE_SIZE_4K_ENABLE			0x02
+#define	PDM_MEM_WINDOW_START			0x4000000
+
+#define	ACP_PDM_RATE				48000
+#define	ACP_PDM_BUFSZ				65536
+#define	ACP_PDM_BLKSZ_MIN			4096
+#define	ACP_PDM_BLKSZ_MAX			32768
+#define	ACP_PDM_BLKSZ_DEFAULT			8192
+
+#define	reg_write(sc, reg, val)	bus_write_4((sc)->io, reg, val)
+#define	reg_read(sc, reg)	bus_read_4((sc)->io, reg)
+
+struct acp_pdm_pcminfo;
+
+struct acp_pdm_chinfo {
+	struct snd_dbuf		*buffer;
+	struct pcm_channel	*channel;
+	struct acp_pdm_pcminfo	*parent;
+	uint64_t		start_bytecnt;
+	uint32_t		blksz;
+	bool			run;
+	bool			resume;	/* was running at suspend */
+};
+
+/*
+ * The PCI driver fills dev and io before it attaches the pcm child, calls
+ * ih from its interrupt handler once the child set it, and sets intr_gone
+ * once that handler is torn down: only then may the child detach.
+ */
+struct acp_pdm_pcminfo {
+	device_t		dev;	/* the pcm child */
+	struct resource		*io;
+	void			(*ih)(struct acp_pdm_pcminfo *);
+	bool			intr_gone;
+	struct mtx		lock;
+	struct acp_pdm_chinfo	rch;
+	bus_dma_tag_t		dmat;
+	unsigned int		gain;
+};
+
+#endif /* _DEV_SOUND_PCI_ACP_H_ */
diff --git a/sys/dev/sound/pci/acp70.c b/sys/dev/sound/pci/acp70.c
new file mode 100644
index 000000000000..f85a492ad3f7
--- /dev/null
+++ b/sys/dev/sound/pci/acp70.c
@@ -0,0 +1,411 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 Vladimir Kondratyev <wulf@FreeBSD.org>
+ * Copyright (c) 2026 Olivier Cochard <olivier@FreeBSD.org>
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE AUTHOR AND CONTRIBUTORS ``AS IS'' AND
+ * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED.  IN NO EVENT SHALL THE AUTHOR OR CONTRIBUTORS BE LIABLE
+ * FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
+ * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
+ * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+/*
+ * AMD Audio Coprocessor 7.x: power, reset and interrupt of the PCI
+ * function, and a pcm child (acp-pdm.c) for the digital microphones.
+ * The register programming follows the Linux driver in sound/soc/amd/ps.
+ */
+
+#include <sys/param.h>
+#include <sys/bus.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/module.h>
+#include <sys/mutex.h>
+#include <sys/rman.h>
+#include <sys/uuid.h>
+
+#include <machine/bus.h>
+
+#include <contrib/dev/acpica/include/acpi.h>
+#include <dev/acpica/acpivar.h>
+
+#include <dev/pci/pcireg.h>
+#include <dev/pci/pcivar.h>
+
+#include <dev/sound/pcm/sound.h>
+#include <dev/sound/pci/acp.h>
+
+#define	ACP70_PGFSM_CNTL_POWER_ON_MASK	0x1F
+#define	ACP70_PGFSM_STATUS_MASK		0xFF
+#define	ACP70_TIMEOUT			400	/* polls of 5 us */
+#define	ACP70_DMIC_ADDR			0x02	/* _ADR of the DMIC node */
+#define	ACP70_DMIC_DEV			0x02	/* acp-audio-device-type */
+
+struct acp70_softc {
+	struct acp_pdm_pcminfo	pdm;
+	device_t		dev;
+	struct resource		*io;
+	int			ioid;
+	struct resource		*irq;
+	int			irqid;
+	void			*ih;
+};
+
+/* "Device Properties UUID for _DSD", daffd814-6eba-4d8c-8a91-bc9bbf4aa301 */
+static const struct uuid acp70_dsd_uuid = {
+	0xdaffd814, 0x6eba, 0x4d8c, 0x8a, 0x91,
+	{ 0xbc, 0x9b, 0xbf, 0x4a, 0xa3, 0x01 }
+};
+
+static void
+acp70_intr(void *arg)
+{
+	struct acp70_softc *sc = arg;
+
+	if ((reg_read(sc, ACP_EXTERNAL_INTR_STAT) & (1U << PDM_DMA_STAT)) == 0)
+		return;
+	reg_write(sc, ACP_EXTERNAL_INTR_STAT, 1U << PDM_DMA_STAT);
+	if (sc->pdm.ih != NULL)
+		sc->pdm.ih(&sc->pdm);
+}
+
+/* Wait until (register & mask) == want; 0 on success. */
+static int
+acp70_poll(struct acp70_softc *sc, bus_size_t reg, uint32_t mask,
+    uint32_t want)
+{
+	int retries;
+
+	for (retries = 0; retries < ACP70_TIMEOUT; retries++) {
+		if ((reg_read(sc, reg) & mask) == want)
+			return (0);
+		DELAY(5);
+	}
+	return (ETIMEDOUT);
+}
+
+static int
+acp70_reset(struct acp70_softc *sc)
+{
+	int retries;
+
+	reg_write(sc, ACP_SOFT_RESET, 1);
+	for (retries = 0; (reg_read(sc, ACP_SOFT_RESET) &
+	    ACP_SOFT_RESET_SOFTRESET_AUDDONE_MASK) == 0; retries++) {
+		if (retries == ACP70_TIMEOUT)
+			return (ETIMEDOUT);
+		DELAY(5);
+	}
+	reg_write(sc, ACP_SOFT_RESET, 0);
+	return (acp70_poll(sc, ACP_SOFT_RESET, 0xffffffff, 0));
+}
+
+static int
+acp70_init(struct acp70_softc *sc)
+{
+	uint32_t st;
+
+	st = reg_read(sc, ACP_PGFSM_STATUS);
+	if (st != 0) {
+		if ((st & ACP70_PGFSM_STATUS_MASK) != 0)
+			reg_write(sc, ACP_PGFSM_CONTROL,
+			    ACP70_PGFSM_CNTL_POWER_ON_MASK);
+		if (acp70_poll(sc, ACP_PGFSM_STATUS, 0xffffffff, 0) != 0) {
+			device_printf(sc->dev, "power on failed (status %#x)\n",
+			    reg_read(sc, ACP_PGFSM_STATUS));
+			return (ETIMEDOUT);
+		}
+	}
+	reg_write(sc, ACP_CONTROL, 0x01);
+	if (acp70_reset(sc) != 0) {
+		device_printf(sc->dev, "reset failed\n");
+		return (ETIMEDOUT);
+	}
+	reg_write(sc, ACP_ZSC_DSP_CTRL, 0);
+	/* Only the PDM source, which acp-pdm.c enables while it records. */
+	reg_write(sc, ACP_EXTERNAL_INTR_STAT, ACP_EXT_INTR_STAT_CLEAR_MASK);
+	reg_write(sc, ACP_EXTERNAL_INTR_CNTL, 0);
+	reg_write(sc, ACP_EXTERNAL_INTR_ENB, 0x01);
+	return (0);
+}
+
+static void
+acp70_deinit(struct acp70_softc *sc)
+{
+	reg_write(sc, ACP_EXTERNAL_INTR_STAT, ACP_EXT_INTR_STAT_CLEAR_MASK);
+	reg_write(sc, ACP_EXTERNAL_INTR_CNTL, 0);
+	reg_write(sc, ACP_EXTERNAL_INTR_ENB, 0);
+	if (acp70_reset(sc) != 0)
+		device_printf(sc->dev, "reset failed\n");
+	reg_write(sc, ACP_ZSC_DSP_CTRL, 0x01);
+}
+
+/* The integer _DSD property propname of handle; 0 on success. */
+static int
+acp70_get_dsd_int(ACPI_HANDLE handle, const char *propname, UINT64 *value)
+{
+	ACPI_BUFFER buf = { ACPI_ALLOCATE_BUFFER, NULL };
+	ACPI_OBJECT *dsd, *uuid, *props, *pkg;
+	int error;
+	UINT32 i;
+
+	if (ACPI_FAILURE(AcpiEvaluateObject(handle, "_DSD", NULL, &buf)))
+		return (ENOENT);
+	error = ENOENT;
+	dsd = buf.Pointer;
+	if (dsd->Type != ACPI_TYPE_PACKAGE)
+		goto out;
+	/* Pairs of a UUID and a package: find the device properties. */
+	props = NULL;
+	for (i = 0; i + 1 < dsd->Package.Count; i += 2) {
+		uuid = &dsd->Package.Elements[i];
+		if (uuid->Type == ACPI_TYPE_BUFFER &&
+		    uuid->Buffer.Length == sizeof(acp70_dsd_uuid) &&
+		    memcmp(uuid->Buffer.Pointer, &acp70_dsd_uuid,
+		    sizeof(acp70_dsd_uuid)) == 0 &&
+		    dsd->Package.Elements[i + 1].Type == ACPI_TYPE_PACKAGE) {
+			props = &dsd->Package.Elements[i + 1];
+			break;
+		}
+	}
+	if (props == NULL)
+		goto out;
+	for (i = 0; i < props->Package.Count; i++) {
+		pkg = &props->Package.Elements[i];
+		if (pkg->Type != ACPI_TYPE_PACKAGE || pkg->Package.Count != 2 ||
+		    pkg->Package.Elements[0].Type != ACPI_TYPE_STRING ||
+		    strcmp(pkg->Package.Elements[0].String.Pointer,
+		    propname) != 0)
+			continue;
+		if (pkg->Package.Elements[1].Type == ACPI_TYPE_INTEGER) {
+			*value = pkg->Package.Elements[1].Integer.Value;
+			error = 0;
+		}
+		break;
+	}
+out:
+	AcpiOsFree(buf.Pointer);
+	return (error);
+}
+
+static ACPI_STATUS
+acp70_find_dmic_node(ACPI_HANDLE handle, UINT32 level, void *context,
+    void **retval)
+{
+	UINT32 adr;
+
+	if (ACPI_FAILURE(acpi_GetInteger(handle, "_ADR", &adr)) ||
+	    adr != ACP70_DMIC_ADDR)
+		return (AE_OK);
+	*retval = handle;
+	return (AE_CTRL_TERMINATE);
+}
+
+/*
+ * As Linux: the pin configuration routes the PDM interface, the DMIC node
+ * below the ACP says it is one, and _WOV, when present, is not 0.
+ */
+static bool
+acp70_has_dmic(struct acp70_softc *sc)
+{
+	ACPI_HANDLE h, dmic = NULL;
+	UINT64 type;
+	UINT32 wov;
+
+	switch (reg_read(sc, ACP_PIN_CONFIG)) {
+	case 4: case 5: case 6: case 7: case 8: case 10: case 11: case 12:
+	case 13: case 14: case 17: case 18: case 19: case 20:
+		break;
+	default:
+		return (false);
+	}
+	if ((h = acpi_get_handle(sc->dev)) == NULL)
+		return (false);
+	if (ACPI_FAILURE(AcpiWalkNamespace(ACPI_TYPE_DEVICE, h, 1,
+	    acp70_find_dmic_node, NULL, NULL, &dmic)) || dmic == NULL)
+		return (false);
+	if (acp70_get_dsd_int(dmic, "acp-audio-device-type", &type) != 0 ||
+	    type != ACP70_DMIC_DEV)
+		return (false);
+	if (ACPI_SUCCESS(acpi_GetInteger(h, "_WOV", &wov)) && wov == 0)
+		return (false);
+	return (true);
+}
+
+static const struct pci_device_table acp70_ids[] = {
+	{ PCI_DEV(0x1022, 0x15e2),
+	  PCI_DESCR("AMD ACP 7.x Audio Coprocessor") },
+};
+
+static int
+acp70_probe(device_t dev)
+{
+	const struct pci_device_table *tbl;
+
+	tbl = PCI_MATCH(dev, acp70_ids);
+	if (tbl == NULL)
+		return (ENXIO);
+	/* Not in acp70_ids[]: pci(4) gives devmatch(8) no revid to match. */
+	switch (pci_get_revid(dev)) {
+	case 0x70:
+	case 0x71:
+	case 0x72:
+		break;
+	default:
+		return (ENXIO);
+	}
+	device_set_desc(dev, tbl->descr);
+	return (BUS_PROBE_DEFAULT);
+}
+
+static void
+acp70_release(struct acp70_softc *sc)
+{
+	if (sc->ih != NULL)
+		bus_teardown_intr(sc->dev, sc->irq, sc->ih);
+	if (sc->irq != NULL)
+		bus_release_resource(sc->dev, SYS_RES_IRQ, sc->irqid, sc->irq);
+	if (sc->irqid != 0)
+		pci_release_msi(sc->dev);
+	if (sc->io != NULL)
+		bus_release_resource(sc->dev, SYS_RES_MEMORY, sc->ioid, sc->io);
+}
+
+static int
+acp70_attach(device_t dev)
+{
+	struct acp70_softc *sc = device_get_softc(dev);
+	int msic;
+
+	sc->dev = dev;
+	pci_enable_busmaster(dev);
+
+	sc->ioid = PCIR_BAR(0);
+	sc->io = bus_alloc_resource_any(dev, SYS_RES_MEMORY, &sc->ioid,
+	    RF_ACTIVE);
+	if (sc->io == NULL) {
+		device_printf(dev, "cannot map registers\n");
+		return (ENXIO);
+	}
+	/* The highest access is the last page table entry of the ring. */
+	if (rman_get_size(sc->io) < ACP_SCRATCH_REG_0 +
+	    ACP_PDM_BUFSZ / PAGE_SIZE * 8) {
+		device_printf(dev, "register window too small\n");
+		goto bad;
+	}
+	if (acp70_init(sc) != 0)
+		goto bad;
+	if (!acp70_has_dmic(sc)) {
+		device_printf(dev, "no digital microphone (pin config %#x)\n",
+		    reg_read(sc, ACP_PIN_CONFIG));
+		goto bad_hw;
+	}
+
+	msic = 1;
+	if (pci_alloc_msi(dev, &msic) == 0)
+		sc->irqid = 1;
+	sc->irq = bus_alloc_resource_any(dev, SYS_RES_IRQ, &sc->irqid,
+	    RF_ACTIVE | (sc->irqid == 0 ? RF_SHAREABLE : 0));
+	if (sc->irq == NULL || bus_setup_intr(dev, sc->irq,
+	    INTR_MPSAFE | INTR_TYPE_AV, NULL, acp70_intr, sc, &sc->ih) != 0) {
+		device_printf(dev, "cannot set up interrupt\n");
+		goto bad_hw;
+	}
+
+	sc->pdm.io = sc->io;
+	sc->pdm.dev = device_add_child(dev, "pcm", DEVICE_UNIT_ANY);
+	if (sc->pdm.dev == NULL) {
+		device_printf(dev, "cannot add the pcm device\n");
+		goto bad_hw;
+	}
+	device_set_ivars(sc->pdm.dev, &sc->pdm);
+	bus_attach_children(dev);
+	return (0);
+
+bad_hw:
+	acp70_deinit(sc);
+bad:
+	acp70_release(sc);
+	return (ENXIO);
+}
+
+static int
+acp70_detach(device_t dev)
+{
+	struct acp70_softc *sc = device_get_softc(dev);
+	int error;
+
+	/* acp-pdm.c frees its channel on detach: no interrupt after it. */
+	if (sc->ih != NULL) {
+		bus_teardown_intr(dev, sc->irq, sc->ih);
+		sc->ih = NULL;
+	}
+	sc->pdm.intr_gone = true;
+	if ((error = bus_generic_detach(dev)) != 0)
+		return (error);
+	acp70_deinit(sc);
+	acp70_release(sc);
+	return (0);
+}
+
+static int
+acp70_suspend(device_t dev)
+{
+	struct acp70_softc *sc = device_get_softc(dev);
+	int error;
+
+	if ((error = bus_generic_suspend(dev)) != 0)
+		return (error);
+	acp70_deinit(sc);
+	return (0);
+}
+
+static int
+acp70_resume(device_t dev)
+{
+	struct acp70_softc *sc = device_get_softc(dev);
+	int error;
+
+	if ((error = acp70_init(sc)) != 0)
+		return (error);
+	return (bus_generic_resume(dev));
+}
+
+static device_method_t acp70_methods[] = {
+	DEVMETHOD(device_probe,		acp70_probe),
+	DEVMETHOD(device_attach,	acp70_attach),
+	DEVMETHOD(device_detach,	acp70_detach),
+	DEVMETHOD(device_suspend,	acp70_suspend),
+	DEVMETHOD(device_resume,	acp70_resume),
+	DEVMETHOD(bus_get_dma_tag,	bus_generic_get_dma_tag),
+	DEVMETHOD_END
+};
+
+static driver_t acp70_driver = {
+	"acp70",
+	acp70_methods,
+	sizeof(struct acp70_softc),
+};
+
+DRIVER_MODULE(snd_acp70, pci, acp70_driver, 0, 0);
+PCI_PNP_INFO(acp70_ids);
+MODULE_DEPEND(snd_acp70, snd_acp_pdm, 1, 1, 1);
+MODULE_DEPEND(snd_acp70, acpi, 1, 1, 1);
+MODULE_VERSION(snd_acp70, 1);
