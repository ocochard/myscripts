--- a/sys/dev/sound/pci/acp.h
+++ b/sys/dev/sound/pci/acp.h
@@ -117,6 +117,7 @@ struct acp_pdm_pcminfo {
 	struct acp_pdm_chinfo	rch;
 	bus_dma_tag_t		dmat;
 	unsigned int		gain;
+	bool			muted;	/* recording level 0 */
 };
 
