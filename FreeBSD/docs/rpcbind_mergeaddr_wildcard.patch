+/*
+ * A datagram transport bound to the wildcard address reports that address as
+ * its local one, which says nothing about where a request arrived.
+ */
+static bool
+is_anyaddr(const struct netbuf *nb)
+{
+	const struct sockaddr_in *sin;
+#ifdef INET6
+	const struct sockaddr_in6 *sin6;
+#endif
+
+	switch (((const struct sockaddr *)nb->buf)->sa_family) {
+	case AF_INET:
+		sin = nb->buf;
+		return (sin->sin_addr.s_addr == htonl(INADDR_ANY));
+#ifdef INET6
+	case AF_INET6:
+		sin6 = nb->buf;
+		return (IN6_IS_ADDR_UNSPECIFIED(&sin6->sin6_addr));
+#endif
+	default:
+		return (false);
+	}
+}
