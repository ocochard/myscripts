+struct procctl_syscall_dispatch {
+	int		sd_mode;
+	int		sd_pad0;
+	uintptr_t	sd_start;
+	size_t		sd_len;
+	char		*sd_selector;
+	u_int		sd_pad1[8];
+};
+.Ed
+.Pp
+If
+.Va sd_mode
+is
+.Dv PROC_SYSCALL_DISPATCH_ON ,
+then a system call is not executed, and the thread instead receives
+.Dv SIGSYS
+with
+.Va si_code
+set to
+.Dv SYS_USER_DISPATCH ,
+.Va si_addr
+set to the address following the system call instruction and
+.Va si_syscall
+set to the system call number, unless one of the following is true:
+.Bl -bullet
+.It
+The address following the system call instruction is inside
+.Bq Va sd_start , Va sd_start No + Va sd_len .
+.It
+The system call is made from the shared page, which holds the signal
+trampoline.
+.It
+.Va sd_selector
+is not
+.Dv NULL
+and the byte it points to holds
+.Dv PROC_SYSCALL_DISPATCH_ALLOW .
+Any other value, normally
+.Dv PROC_SYSCALL_DISPATCH_BLOCK ,
+traps the system call.
+The thread can flip the byte without entering the kernel.
+If the byte cannot be read, the thread receives
+.Dv SIGSEGV .
+.El
+.Pp
+When a signal is delivered to the thread while the byte pointed to by
+.Va sd_selector
+holds another value than
+.Dv PROC_SYSCALL_DISPATCH_ALLOW ,
+it is set to
+.Dv PROC_SYSCALL_DISPATCH_ALLOW ,
+since signal handlers, and the
+.Lb libthr
+wrapper around them, are native code.
+The previous value is saved in the signal frame, and
+.Xr sigreturn 2
+restores it if the byte still holds
+.Dv PROC_SYSCALL_DISPATCH_ALLOW ;
+a handler that redirects the thread sets the byte for the code it
