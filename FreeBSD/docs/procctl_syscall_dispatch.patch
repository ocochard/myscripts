+/*
+ * Syscall dispatch lets a process that runs foreign machine code, such as
+ * Wine running Windows programs, trap the system calls that this code
+ * makes itself with the syscall instruction, and emulate them in a SIGSYS
+ * handler.  The semantics follow Linux's PR_SET_SYSCALL_USER_DISPATCH.
+ * The state is per thread, not inherited by fork(2) or new threads, and
+ * cleared by execve(2), as on Linux.  amd64 only.
+ */
+/* Tag of a selector saved in mc_spare[0] by sendsig(): "SD". */
+#define	SYSCALL_DISPATCH_SAVED	0x5344000000000000L
+
+#ifdef __amd64__
+static bool
+syscall_dispatch_pad_zero(const struct procctl_syscall_dispatch *sd)
+{
+	u_int i;
+
+	if (sd->sd_pad0 != 0)
+		return (false);
+	for (i = 0; i < nitems(sd->sd_pad1); i++)
+		if (sd->sd_pad1[i] != 0)
+			return (false);
+	return (true);
+}
+#endif
+
+static int
+syscall_dispatch_ctl(struct thread *td, struct proc *p, void *data)
+{
+#ifdef __amd64__
+	struct procctl_syscall_dispatch *sd;
+
+	PROC_LOCK_ASSERT(p, MA_OWNED);
+	if (p != td->td_proc)
+		return (EINVAL);
+	sd = data;
+	if (!syscall_dispatch_pad_zero(sd))
+		return (EINVAL);
+	switch (sd->sd_mode) {
+	case PROC_SYSCALL_DISPATCH_OFF:
+		if (sd->sd_start != 0 || sd->sd_len != 0 ||
+		    sd->sd_selector != NULL)
+			return (EINVAL);
+		td->td_pflags2 &= ~TDP2_SYSCALL_DISPATCH;
+		break;
+	case PROC_SYSCALL_DISPATCH_ON:
+		if (sd->sd_start + sd->sd_len < sd->sd_start)
+			return (EINVAL);
+		td->td_sd_start = sd->sd_start;
+		td->td_sd_len = sd->sd_len;
+		td->td_sd_selector = sd->sd_selector;
+		td->td_pflags2 |= TDP2_SYSCALL_DISPATCH;
+		break;
+	default:
+		return (EINVAL);
+	}
+	return (0);
+#else
+	return (EOPNOTSUPP);
+#endif
+}
+
+static int
+syscall_dispatch_status(struct thread *td, struct proc *p, void *data)
+{
+#ifdef __amd64__
+	struct procctl_syscall_dispatch *sd;
+
+	PROC_LOCK_ASSERT(p, MA_OWNED);
+	if (p != td->td_proc)
+		return (EINVAL);
+	sd = data;
+	if ((td->td_pflags2 & TDP2_SYSCALL_DISPATCH) != 0) {
+		sd->sd_mode = PROC_SYSCALL_DISPATCH_ON;
+		sd->sd_start = td->td_sd_start;
+		sd->sd_len = td->td_sd_len;
+		sd->sd_selector = td->td_sd_selector;
+	} else {
+		sd->sd_mode = PROC_SYSCALL_DISPATCH_OFF;
+	}
+	return (0);
+#else
+	return (EOPNOTSUPP);
+#endif
+}
+
+/*
+ * Called by syscallenter() for threads with TDP2_SYSCALL_DISPATCH, before
+ * the arguments are decoded, as they follow another system's conventions.
+ * Returns true if the syscall must not run: a signal was posted, and the
+ * thread returns to usermode with the registers as the syscall instruction
+ * left them, so the SIGSYS handler finds the syscall number and arguments
+ * where the caller put them.
+ */
+bool
+syscall_dispatch_trap(struct thread *td)
+{
+#ifdef __amd64__
+	struct proc *p;
+	struct trapframe *frame;
+	ksiginfo_t ksi;
+	uintptr_t pc;
+	int sel;
+
+	p = td->td_proc;
+	frame = td->td_frame;
+	pc = frame->tf_rip;		/* after the syscall instruction */
+	if (pc - td->td_sd_start < td->td_sd_len)
+		return (false);
+	/* Let the signal trampoline in the shared page call sigreturn(2). */
+	if (p->p_sysent->sv_shared_page_obj != NULL &&
+	    pc - p->p_vmspace->vm_shp_base < p->p_sysent->sv_shared_page_len)
+		return (false);
+	sel = PROC_SYSCALL_DISPATCH_BLOCK;
+	if (td->td_sd_selector != NULL) {
+		sel = fubyte(td->td_sd_selector);
+		if (sel == PROC_SYSCALL_DISPATCH_ALLOW ||
+		    sel == PROC_SYSCALL_DISPATCH_ALLOW_SIGNAL)
+			return (false);
+	}
+
+	/*
+	 * The syscall entry saved %r10, the fourth argument, in tf_rcx and
+	 * saved neither %r10 nor %r11.  Rebuild them before any signal
+	 * frame is written.
+	 */
+	frame->tf_r10 = frame->tf_rcx;
+	frame->tf_rcx = frame->tf_rip;
+	frame->tf_r11 = frame->tf_rflags;
+	set_pcb_flags(td->td_pcb, PCB_FULL_IRET);
+	/* For ktrace and syscallret(), which report td_sa. */
+	td->td_sa.code = td->td_sa.original_code = frame->tf_rax;
+
+	ksiginfo_init_trap(&ksi);
+	if (sel == -1) {
+		ksi.ksi_signo = SIGSEGV;
+		ksi.ksi_code = SEGV_MAPERR;
+		ksi.ksi_addr = td->td_sd_selector;
+	} else {
+		ksi.ksi_signo = SIGSYS;
+		ksi.ksi_code = SYS_USER_DISPATCH;
+		ksi.ksi_addr = (void *)pc;
+		ksi.ksi_info.si_syscall = frame->tf_rax;
+	}
+	trapsignal(td, &ksi);
+	return (true);
+#else
+	return (false);
+#endif
+}
+
+/*
+ * Called by sendsig() with no locks held, before the signal frame is
+ * copied out.  Signal handlers are native code, and libthr wraps them and
+ * makes system calls before the program's handler runs, so make the
+ * selector allow.  It gets PROC_SYSCALL_DISPATCH_ALLOW_SIGNAL, not ALLOW,
+ * so that syscall_dispatch_sigreturn() can tell whether the handler wrote
+ * the byte; the previous value is saved in the frame.
+ */
+void
+syscall_dispatch_sendsig(struct thread *td, long *saved)
+{
+	int sel;
+
+	if ((td->td_pflags2 & TDP2_SYSCALL_DISPATCH) == 0 ||
+	    td->td_sd_selector == NULL)
+		return;
+	sel = fubyte(td->td_sd_selector);
+	if (sel == -1 || sel == PROC_SYSCALL_DISPATCH_ALLOW)
+		return;
+	if (subyte(td->td_sd_selector,
+	    PROC_SYSCALL_DISPATCH_ALLOW_SIGNAL) == 0)
+		*saved = SYSCALL_DISPATCH_SAVED | sel;
+}
+
+/*
+ * Called by sigreturn(2).  Restore the selector saved at signal delivery
+ * if the byte still holds the value sendsig() wrote: a handler that wrote
+ * it chose the state for the code it returns to.
+ */
+void
+syscall_dispatch_sigreturn(struct thread *td, long saved)
+{
+	if ((td->td_pflags2 & TDP2_SYSCALL_DISPATCH) == 0 ||
+	    td->td_sd_selector == NULL ||
+	    (saved & ~0xffL) != SYSCALL_DISPATCH_SAVED)
+		return;
+	if (fubyte(td->td_sd_selector) == PROC_SYSCALL_DISPATCH_ALLOW_SIGNAL)
+		(void)subyte(td->td_sd_selector, saved & 0xff);
+}
+
 enum {
 	PCTL_SLOCKED,
 	PCTL_XLOCKED,
@@ -1166,6 +1364,20 @@ static const struct procctl_cmd_info procctl_cmds_info[] = {
 	      .need_candebug = false,
 	      .copyin_sz = 0, .copyout_sz = sizeof(int),
 	      .exec = logsigexit_status, .copyout_on_error = false, },
+	[PROC_SYSCALL_DISPATCH_CTL] =
+	    { .lock_tree = PCTL_UNLOCKED, .one_proc = true,
+	      .esrch_is_einval = false, .no_nonnull_data = false,
+	      .need_candebug = false,
+	      .copyin_sz = sizeof(struct procctl_syscall_dispatch),
+	      .copyout_sz = 0,
+	      .exec = syscall_dispatch_ctl, .copyout_on_error = false, },
+	[PROC_SYSCALL_DISPATCH_STATUS] =
+	    { .lock_tree = PCTL_UNLOCKED, .one_proc = true,
+	      .esrch_is_einval = false, .no_nonnull_data = false,
+	      .need_candebug = false,
+	      .copyin_sz = 0,
+	      .copyout_sz = sizeof(struct procctl_syscall_dispatch),
+	      .exec = syscall_dispatch_status, .copyout_on_error = false, },
 };
 
