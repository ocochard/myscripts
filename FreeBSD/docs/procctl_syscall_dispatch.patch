+
+/*
+ * Tests for procctl(PROC_SYSCALL_DISPATCH_CTL): system calls made from
+ * outside the allowed range while the selector byte says BLOCK must raise
+ * SIGSYS instead of running.  Most cases use libsys, where libc and
+ * libthr make their system calls, as the allowed range, as Wine does; the
+ * trapped calls come from sd_raw_getpid() below.  The program links libthr
+ * so that signal delivery goes through its handler wrapper.
+ *
+ * The stub_* cases trap the whole process instead, as an interposer that
+ * must see every system call does: only sd_stub() may make system calls,
+ * and the SIGSYS handler runs every trapped call through it.
+ */
+
+#include <sys/param.h>
+#include <sys/auxv.h>
+#include <sys/elf_common.h>
+#include <sys/mman.h>
+#include <sys/procctl.h>
+#include <sys/syscall.h>
+#include <sys/time.h>
+#include <sys/wait.h>
+#include <machine/psl.h>
+
+#include <atf-c.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <link.h>
+#include <pthread.h>
+#include <pthread_np.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#define	FAKE_RET	4242
+#define	ARG4		0x1234567890abcdefL
+
+/* getpid(2) with %r10 set to the argument, from outside libsys. */
+long	sd_raw_getpid(long r10);
+__asm__(
+"	.text\n"
+"	.globl	sd_raw_getpid\n"
+"	.type	sd_raw_getpid,@function\n"
+"sd_raw_getpid:\n"
+"	movq	%rdi,%r10\n"
+"	movl	$" __XSTRING(SYS_getpid) ",%eax\n"
+"	syscall\n"
+"	ret\n"
+"	.size	sd_raw_getpid, . - sd_raw_getpid\n");
+
+/*
+ * Run the system call described by *r, alone in its own section so that
+ * its range can be the allowed one.  Only the six register arguments are
+ * passed: a call with a seventh argument on the stack, such as syscall(2)
+ * with six arguments of its own, would get garbage.
+ */
+struct sd_regs {
+	long	rax, rdi, rsi, rdx, r10, r8, r9;
+	long	err;			/* out: -1 if the carry flag was set */
+};
+void	sd_stub(struct sd_regs *);
+extern char __start_sd_stub_text[], __stop_sd_stub_text[];
+__asm__(
+"	.pushsection sd_stub_text,\"ax\",@progbits\n"
+"	.globl	sd_stub\n"
+"	.type	sd_stub,@function\n"
+"sd_stub:\n"
+"	pushq	%rbx\n"
+"	movq	%rdi,%rbx\n"
+"	movq	0(%rbx),%rax\n"
+"	movq	8(%rbx),%rdi\n"
+"	movq	16(%rbx),%rsi\n"
+"	movq	24(%rbx),%rdx\n"
+"	movq	32(%rbx),%r10\n"
+"	movq	40(%rbx),%r8\n"
+"	movq	48(%rbx),%r9\n"
+"	syscall\n"
+"	movq	%rax,0(%rbx)\n"
+"	movq	%rdx,24(%rbx)\n"
+"	sbbq	%rcx,%rcx\n"
+"	movq	%rcx,56(%rbx)\n"
+"	popq	%rbx\n"
+"	ret\n"
+"	.size	sd_stub, . - sd_stub\n"
+"	.popsection\n");
+
+static volatile char selector;
+static volatile sig_atomic_t sigsys_cnt, sigsegv_cnt;
+static volatile int got_code, got_syscall, alrm_selector;
+static volatile long got_rax, got_r10, got_rcx, got_rip;
+static void * volatile got_addr;
+static uintptr_t libsys_start;
+static size_t libsys_len;
+
+static int
+libsys_cb(struct dl_phdr_info *info, size_t size __unused, void *arg __unused)
+{
+	const char *p;
+	size_t end;
+	int i;
+
+	p = strrchr(info->dlpi_name, '/');
+	p = p != NULL ? p + 1 : info->dlpi_name;
+	if (strcmp(p, "libsys.so.7") != 0)
+		return (0);
+	libsys_start = info->dlpi_addr;
+	for (i = 0, end = 0; i < info->dlpi_phnum; i++)
+		end = MAX(end, info->dlpi_phdr[i].p_vaddr +
+		    info->dlpi_phdr[i].p_memsz);
+	libsys_len = end;
+	return (1);
+}
+
+static int
+sd_ctl(int mode, uintptr_t start, size_t len, char *sel)
+{
+	struct procctl_syscall_dispatch sd;
+
+	memset(&sd, 0, sizeof(sd));
+	sd.sd_mode = mode;
+	sd.sd_start = start;
+	sd.sd_len = len;
+	sd.sd_selector = sel;
+	return (procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_CTL, &sd));
+}
+
+static void
+sigsys_handler(int sig __unused, siginfo_t *si, void *ctx)
+{
+	ucontext_t *uc = ctx;
+
+	/* Native code from here on. */
+	selector = PROC_SYSCALL_DISPATCH_ALLOW;
+	sigsys_cnt++;
+	got_code = si->si_code;
+	got_syscall = si->si_syscall;
+	got_addr = si->si_addr;
+	got_rax = uc->uc_mcontext.mc_rax;
+	got_r10 = uc->uc_mcontext.mc_r10;
+	got_rcx = uc->uc_mcontext.mc_rcx;
+	got_rip = uc->uc_mcontext.mc_rip;
+	/* Emulate the call. */
+	uc->uc_mcontext.mc_rax = FAKE_RET;
+	uc->uc_mcontext.mc_rflags &= ~PSL_C;
+}
+
+/* Install the SIGSYS handler and enable dispatch for libsys. */
+static void
+setup(char *sel)
+{
+	struct sigaction sa;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = sigsys_handler;
+	sa.sa_flags = SA_SIGINFO;
+	ATF_REQUIRE(sigaction(SIGSYS, &sa, NULL) == 0);
+	ATF_REQUIRE_MSG(dl_iterate_phdr(libsys_cb, NULL) != 0,
+	    "libsys.so.7 not found");
+	selector = PROC_SYSCALL_DISPATCH_ALLOW;
+	ATF_REQUIRE(sd_ctl(PROC_SYSCALL_DISPATCH_ON, libsys_start,
+	    libsys_len, sel) == 0);
+}
+
+ATF_TC_WITHOUT_HEAD(ctl_invalid);
+ATF_TC_BODY(ctl_invalid, tc)
+{
+	struct procctl_syscall_dispatch sd;
+	pid_t child;
+	int status;
+
+	memset(&sd, 0, sizeof(sd));
+	sd.sd_mode = PROC_SYSCALL_DISPATCH_ON;
+	sd.sd_pad1[0] = 1;
+	ATF_CHECK_ERRNO(EINVAL,
+	    procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_CTL, &sd) == -1);
+
+	memset(&sd, 0, sizeof(sd));
+	sd.sd_mode = 42;
+	ATF_CHECK_ERRNO(EINVAL,
+	    procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_CTL, &sd) == -1);
+
+	ATF_CHECK_ERRNO(EINVAL,
+	    sd_ctl(PROC_SYSCALL_DISPATCH_OFF, 0, 1, NULL) == -1);
+	ATF_CHECK_ERRNO(EINVAL,
+	    sd_ctl(PROC_SYSCALL_DISPATCH_ON, ~(uintptr_t)0, 2, NULL) == -1);
+
+	/* Only the calling process. */
+	child = fork();
+	ATF_REQUIRE(child != -1);
+	if (child == 0) {
+		pause();
+		_exit(0);
+	}
+	memset(&sd, 0, sizeof(sd));
+	sd.sd_mode = PROC_SYSCALL_DISPATCH_ON;
+	ATF_CHECK_ERRNO(EINVAL,
+	    procctl(P_PID, child, PROC_SYSCALL_DISPATCH_CTL, &sd) == -1);
+	ATF_CHECK_ERRNO(EINVAL,
+	    procctl(P_PID, child, PROC_SYSCALL_DISPATCH_STATUS, &sd) == -1);
+	ATF_REQUIRE(kill(child, SIGKILL) == 0);
+	ATF_REQUIRE(waitpid(child, &status, 0) == child);
+}
+
+ATF_TC_WITHOUT_HEAD(status);
+ATF_TC_BODY(status, tc)
+{
+	struct procctl_syscall_dispatch st;
+
+	ATF_REQUIRE(procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_STATUS, &st) == 0);
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_OFF, st.sd_mode);
+
+	ATF_REQUIRE(sd_ctl(PROC_SYSCALL_DISPATCH_ON, 0x1000, 0x2000,
+	    (char *)&selector) == 0);
+	ATF_REQUIRE(procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_STATUS, &st) == 0);
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_ON, st.sd_mode);
+	ATF_CHECK_EQ(0x1000, st.sd_start);
+	ATF_CHECK_EQ(0x2000, st.sd_len);
+	ATF_CHECK(st.sd_selector == (char *)&selector);
+
+	ATF_REQUIRE(sd_ctl(PROC_SYSCALL_DISPATCH_OFF, 0, 0, NULL) == 0);
+	ATF_REQUIRE(procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_STATUS, &st) == 0);
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_OFF, st.sd_mode);
+}
+
+ATF_TC_WITHOUT_HEAD(trap);
+ATF_TC_BODY(trap, tc)
+{
+	long ret;
+	char after;
+
+	setup((char *)&selector);
+	selector = PROC_SYSCALL_DISPATCH_BLOCK;
+	ret = sd_raw_getpid(ARG4);
+	after = selector;
+	atomic_signal_fence(memory_order_seq_cst);
+
+	ATF_CHECK_EQ(1, sigsys_cnt);
+	ATF_CHECK_EQ(FAKE_RET, ret);
+	ATF_CHECK_EQ(SYS_USER_DISPATCH, got_code);
+	ATF_CHECK_EQ(SYS_getpid, got_syscall);
+	ATF_CHECK_EQ(SYS_getpid, got_rax);
+	ATF_CHECK_EQ(ARG4, got_r10);
+	ATF_CHECK_EQ(got_rip, got_rcx);
+	ATF_CHECK(got_addr == (void *)got_rip);
+	/* The handler wrote ALLOW: sigreturn(2) must keep it. */
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_ALLOW, after);
+}
+
+ATF_TC_WITHOUT_HEAD(selector_allow);
+ATF_TC_BODY(selector_allow, tc)
+{
+	setup((char *)&selector);
+	ATF_CHECK_EQ(getpid(), sd_raw_getpid(0));
+	ATF_CHECK_EQ(0, sigsys_cnt);
+}
+
+ATF_TC_WITHOUT_HEAD(range_allow);
+ATF_TC_BODY(range_allow, tc)
+{
+	pid_t pid;
+
+	setup((char *)&selector);
+	selector = PROC_SYSCALL_DISPATCH_BLOCK;
+	pid = getpid();			/* from libsys: allowed */
+	selector = PROC_SYSCALL_DISPATCH_ALLOW;
+	ATF_CHECK_EQ(0, sigsys_cnt);
+	ATF_CHECK_EQ(pid, sd_raw_getpid(0));
+}
+
+ATF_TC_WITHOUT_HEAD(null_selector);
+ATF_TC_BODY(null_selector, tc)
+{
+	setup(NULL);
+	ATF_CHECK_EQ(FAKE_RET, sd_raw_getpid(0));
+	ATF_CHECK_EQ(FAKE_RET, sd_raw_getpid(0));
+	ATF_CHECK_EQ(2, sigsys_cnt);
+	ATF_CHECK(getpid() > 0);	/* libsys still works */
+}
+
+static void
+sigsegv_handler(int sig __unused, siginfo_t *si, void *ctx __unused)
+{
+	sigsegv_cnt++;
+	got_code = si->si_code;
+	got_addr = si->si_addr;
+	/* From libsys, allowed: stop trapping. */
+	(void)sd_ctl(PROC_SYSCALL_DISPATCH_OFF, 0, 0, NULL);
+}
+
+ATF_TC_WITHOUT_HEAD(selector_fault);
+ATF_TC_BODY(selector_fault, tc)
+{
+	struct sigaction sa;
+	char *page;
+	long ret;
+
+	page = mmap(NULL, PAGE_SIZE, PROT_NONE, MAP_ANON, -1, 0);
+	ATF_REQUIRE(page != MAP_FAILED);
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = sigsegv_handler;
+	sa.sa_flags = SA_SIGINFO;
+	ATF_REQUIRE(sigaction(SIGSEGV, &sa, NULL) == 0);
+	setup(page);
+
+	ret = sd_raw_getpid(0);
+	atomic_signal_fence(memory_order_seq_cst);
+	ATF_CHECK_EQ(1, sigsegv_cnt);
+	ATF_CHECK_EQ(SEGV_MAPERR, got_code);
+	ATF_CHECK(got_addr == page);
+	ATF_CHECK_EQ(0, sigsys_cnt);
+	/* The call did not run and the registers were left alone. */
+	ATF_CHECK_EQ(SYS_getpid, ret);
+	ATF_CHECK_EQ(getpid(), sd_raw_getpid(0));
+}
+
+static void
+sigalrm_handler(int sig __unused)
+{
+	alrm_selector = selector;
+}
+
+ATF_TC_WITHOUT_HEAD(signal_selector);
+ATF_TC_BODY(signal_selector, tc)
+{
+	struct itimerval it;
+	struct sigaction sa;
+	char after;
+
+	setup((char *)&selector);
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_handler = sigalrm_handler;
+	ATF_REQUIRE(sigaction(SIGALRM, &sa, NULL) == 0);
+	memset(&it, 0, sizeof(it));
+	it.it_value.tv_usec = 10000;
+	alrm_selector = -1;
+	ATF_REQUIRE(setitimer(ITIMER_REAL, &it, NULL) == 0);
+
+	/* No system call while the selector says BLOCK. */
+	selector = PROC_SYSCALL_DISPATCH_BLOCK;
+	while (alrm_selector == -1)
+		;
+	after = selector;
+	selector = PROC_SYSCALL_DISPATCH_ALLOW;
+
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_ALLOW_SIGNAL, alrm_selector);
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_BLOCK, after);
+	/* libthr's wrapper made its system calls without being trapped. */
+	ATF_CHECK_EQ(0, sigsys_cnt);
+}
+
+/*
+ * rtld and libthr defer signals with sigfastblock(2) around their critical
+ * sections and make system calls there.  The trap must still be delivered,
+ * not kill the process.
+ */
+static void
+require_fastblock(void)
+{
+	int bsdflags;
+
+	if (elf_aux_info(AT_BSDFLAGS, &bsdflags, sizeof(bsdflags)) != 0 ||
+	    (bsdflags & ELF_BSDF_SIGFASTBLK) == 0)
+		atf_tc_skip("sigfastblock disabled (kern.elf64.sigfastblock)");
+}
+
+ATF_TC_WITHOUT_HEAD(fastblock);
+ATF_TC_BODY(fastblock, tc)
+{
+	pid_t child;
+	long ret;
+	int status;
+
+	require_fastblock();
+	child = fork();
+	ATF_REQUIRE(child != -1);
+	if (child == 0) {
+		struct sigaction sa;
+
+		/* No ATF calls in the child: report through the exit status. */
+		memset(&sa, 0, sizeof(sa));
+		sa.sa_sigaction = sigsys_handler;
+		sa.sa_flags = SA_SIGINFO;
+		if (sigaction(SIGSYS, &sa, NULL) != 0 ||
+		    dl_iterate_phdr(libsys_cb, NULL) == 0 ||
+		    sd_ctl(PROC_SYSCALL_DISPATCH_ON, libsys_start, libsys_len,
+		    (char *)&selector) != 0)
+			_exit(2);
+		pthread_signals_block_np();
+		selector = PROC_SYSCALL_DISPATCH_BLOCK;
+		ret = sd_raw_getpid(0);
+		pthread_signals_unblock_np();
+		_exit(ret == FAKE_RET && sigsys_cnt == 1 ? 0 : 1);
+	}
+	ATF_REQUIRE(waitpid(child, &status, 0) == child);
+	ATF_CHECK_MSG(!WIFSIGNALED(status), "killed by signal %d",
+	    WTERMSIG(status));
+	ATF_CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+}
+
+/* Run the trapped call through sd_stub() and return its result. */
+static void
+sigsys_stub_handler(int sig __unused, siginfo_t *si, void *ctx)
+{
+	mcontext_t *mc = &((ucontext_t *)ctx)->uc_mcontext;
+	struct sd_regs r = { mc->mc_rax, mc->mc_rdi, mc->mc_rsi, mc->mc_rdx,
+	    mc->mc_r10, mc->mc_r8, mc->mc_r9, 0 };
+
+	sigsys_cnt++;
+	got_addr = si->si_addr;
+	sd_stub(&r);
+	mc->mc_rax = r.rax;
+	mc->mc_rdx = r.rdx;
+	if (r.err != 0)
+		mc->mc_rflags |= PSL_C;
+	else
+		mc->mc_rflags &= ~PSL_C;
+}
+
+/*
+ * Trap every system call of the thread but sd_stub()'s.  The handler is
+ * installed with the raw system call: libthr's sigaction() and signal
+ * wrapper take locks that a trapped call made by rtld or libthr may hold.
+ */
+static int
+stub_setup(void)
+{
+	struct sigaction sa;
+
+	memset(&sa, 0, sizeof(sa));
+	sa.sa_sigaction = sigsys_stub_handler;
+	sa.sa_flags = SA_SIGINFO;
+	if (syscall(SYS_sigaction, SIGSYS, &sa, NULL) != 0)
+		return (-1);
+	selector = PROC_SYSCALL_DISPATCH_BLOCK;
+	return (sd_ctl(PROC_SYSCALL_DISPATCH_ON,
+	    (uintptr_t)__start_sd_stub_text,
+	    __stop_sd_stub_text - __start_sd_stub_text, (char *)&selector));
+}
+
+/* libc's own system calls are trapped and still give the right results. */
+ATF_TC_WITHOUT_HEAD(stub_libc);
+ATF_TC_BODY(stub_libc, tc)
+{
+	pid_t pid, ppid, tpid, tppid;
+	void *addr;
+	int cnt;
+
+	pid = getpid();
+	ppid = getppid();
+	ATF_REQUIRE(dl_iterate_phdr(libsys_cb, NULL) != 0);
+	ATF_REQUIRE(stub_setup() == 0);
+	tpid = getpid();
+	tppid = getppid();
+	addr = got_addr;		/* from the last trapped call */
+	cnt = sigsys_cnt;
+	/* Runs through the handler too. */
+	ATF_REQUIRE(sd_ctl(PROC_SYSCALL_DISPATCH_OFF, 0, 0, NULL) == 0);
+	selector = PROC_SYSCALL_DISPATCH_ALLOW;
+
+	ATF_CHECK_EQ(pid, tpid);
+	ATF_CHECK_EQ(ppid, tppid);
+	ATF_CHECK(cnt > 0);
+	ATF_CHECK_MSG((uintptr_t)addr >= libsys_start &&
+	    (uintptr_t)addr < libsys_start + libsys_len,
+	    "si_addr %p is not in libsys", addr);
+	ATF_CHECK_EQ(cnt + 1, sigsys_cnt);	/* and the procctl(2) above */
+}
+
+/*
+ * dlopen(3) while every system call is trapped: rtld makes them while it
+ * holds its lock with signals deferred by sigfastblock(2), and libthr's
+ * rtld lock callbacks make some too.  Without sigfastblock(2) they block
+ * signals with sigprocmask(2) instead, and the case would not test
+ * trapsignal()'s handling of sigfastblock(2).
+ */
+ATF_TC_WITHOUT_HEAD(stub_dlopen);
+ATF_TC_BODY(stub_dlopen, tc)
+{
+	pid_t child;
+	int status;
+
+	require_fastblock();
+	if (dlopen("libm.so.5", RTLD_LAZY | RTLD_NOLOAD) != NULL)
+		atf_tc_skip("libm.so.5 is already loaded");
+	child = fork();
+	ATF_REQUIRE(child != -1);
+	if (child == 0) {
+		void *h;
+
+		/* No ATF calls in the child: report through the exit status. */
+		if (stub_setup() != 0)
+			_exit(2);
+		h = dlopen("libm.so.5", RTLD_NOW);
+		_exit(h != NULL && dlsym(h, "cos") != NULL && sigsys_cnt > 0 ?
+		    0 : 1);
+	}
+	ATF_REQUIRE(waitpid(child, &status, 0) == child);
+	ATF_CHECK_MSG(!WIFSIGNALED(status), "killed by signal %d",
+	    WTERMSIG(status));
+	ATF_CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+}
+
+ATF_TC_WITHOUT_HEAD(fork_off);
+ATF_TC_BODY(fork_off, tc)
+{
+	struct procctl_syscall_dispatch st;
+	pid_t child;
+	int status;
+
+	setup((char *)&selector);
+	child = fork();
+	ATF_REQUIRE(child != -1);
+	if (child == 0) {
+		memset(&st, 0, sizeof(st));
+		_exit(procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_STATUS,
+		    &st) == 0 && st.sd_mode == PROC_SYSCALL_DISPATCH_OFF ?
+		    0 : 1);
+	}
+	ATF_REQUIRE(waitpid(child, &status, 0) == child);
+	ATF_CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+}
+
+static void *
+thread_status(void *arg)
+{
+	struct procctl_syscall_dispatch *st = arg;
+
+	memset(st, 0, sizeof(*st));
+	if (procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_STATUS, st) != 0)
+		st->sd_mode = -1;
+	return (NULL);
+}
+
+/* The setting is per thread: a new thread starts with it off. */
+ATF_TC_WITHOUT_HEAD(thread_off);
+ATF_TC_BODY(thread_off, tc)
+{
+	struct procctl_syscall_dispatch st;
+	pthread_t thr;
+
+	setup((char *)&selector);
+	ATF_REQUIRE(pthread_create(&thr, NULL, thread_status, &st) == 0);
+	ATF_REQUIRE(pthread_join(thr, NULL) == 0);
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_OFF, st.sd_mode);
+	ATF_REQUIRE(procctl(P_PID, 0, PROC_SYSCALL_DISPATCH_STATUS, &st) == 0);
+	ATF_CHECK_EQ(PROC_SYSCALL_DISPATCH_ON, st.sd_mode);
+}
+
+ATF_TC_WITHOUT_HEAD(off);
+ATF_TC_BODY(off, tc)
+{
+	setup((char *)&selector);
+	ATF_REQUIRE(sd_ctl(PROC_SYSCALL_DISPATCH_OFF, 0, 0, NULL) == 0);
+	selector = PROC_SYSCALL_DISPATCH_BLOCK;
+	ATF_CHECK_EQ(getpid(), sd_raw_getpid(0));
+	selector = PROC_SYSCALL_DISPATCH_ALLOW;
+	ATF_CHECK_EQ(0, sigsys_cnt);
+}
+
+ATF_TP_ADD_TCS(tp)
+{
+	ATF_TP_ADD_TC(tp, ctl_invalid);
+	ATF_TP_ADD_TC(tp, status);
+	ATF_TP_ADD_TC(tp, trap);
+	ATF_TP_ADD_TC(tp, selector_allow);
+	ATF_TP_ADD_TC(tp, range_allow);
+	ATF_TP_ADD_TC(tp, null_selector);
+	ATF_TP_ADD_TC(tp, selector_fault);
+	ATF_TP_ADD_TC(tp, signal_selector);
+	ATF_TP_ADD_TC(tp, fastblock);
+	ATF_TP_ADD_TC(tp, stub_libc);
+	ATF_TP_ADD_TC(tp, stub_dlopen);
+	ATF_TP_ADD_TC(tp, fork_off);
