#!/bin/sh
# Generate a graphviz dot file (or a mermaid markdown block) from the FreeBSD
# audio system (hdaa mainly)
# This tool is an helper to found output pcm to use or to troubleshoot problem
# Work in progress, need to add an option to display ALL the existing nid
# Usage:
# hdaa2dot | dot -Tpng -o soundsetup.png
# hdaa2dot -m >> README.md

set -eu

usage() {
	echo "Usage: $0 [-m]"
	echo "  -m  mermaid markdown output (default: graphviz dot)"
	exit 1
}

format=dot
while getopts "mh" opt; do
	case ${opt} in
	m) format=mermaid ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

# Node label: "name <desc>", or "name" when there is no desc
dot_label() {
	if [ -n "$2" ]; then
		printf '%s <%s>' "$1" "$2"
	else
		printf '%s' "$1"
	fi
}

# Mermaid node: id["name<br/>desc"], id restricted to [a-zA-Z0-9_]
mermaid_node() {
	id=$(printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_')
	if [ -n "$2" ]; then
		printf '%s["%s<br/>%s"]' "${id}" "$1" "$2"
	else
		printf '%s["%s"]' "${id}" "$1"
	fi
}

# Edges collected as "from|from_desc|to|to_desc" lines, rendered at the end
edges=""
add_edge() {
	edges="${edges}$1|$2|$3|$4
"
}

# The graph follows the audio: playback pcm -> codec pin -> (amplifiers),
# and codec pin -> recording pcm. A pcm doing both gets a play and a rec node.
as_group_list=""
hdaa_list=""
play_pcms=""
rec_pcms=""
for pcmid in $(sysctl dev.pcm. | grep %desc | cut -d '.' -f 3); do
	pcm_desc=$(sysctl -n dev.pcm.${pcmid}.%desc)
	eval "pcm_${pcmid}_desc=\${pcm_desc}"
	# pcm4: <Realtek ALC245 (Analog)> (play/rec) default
	pcm_dir=$(sed -n "s/^pcm${pcmid}: .*(\([a-z/]*\)).*/\1/p" /dev/sndstat)
	case "${pcm_dir}" in *play*) play_pcms="${play_pcms} ${pcmid}" ;; esac
	case "${pcm_dir}" in *rec*) rec_pcms="${rec_pcms} ${pcmid}" ;; esac
	if sysctl -n dev.pcm.${pcmid}.%parent | grep -q hdaa; then
		hdaa_id=$(sysctl -n dev.pcm.${pcmid}.%parent)
		hdaa_id=${hdaa_id#hdaa}
		if ! echo "${hdaa_list}" | grep -wq ${hdaa_id}; then
			hdaa_list="${hdaa_list} ${hdaa_id}"
		fi
		# Extracting nid attached to the hdaa pcm
		#% sysctl -n dev.pcm.0.%location
		#nid=31,25,35,27
		#nid=7
		nid_list=$(sysctl -n dev.pcm.${pcmid}.%location | cut -d'=' -f 2)
		for i in $(echo ${nid_list} | sed "s/,/ /g"); do
			line=$(sysctl -n dev.hdaa.${hdaa_id}.nid${i}_config)
			# 0x90a60120 as=2 seq=0 device=Mic conn=Fixed ctype=Digital loc=Internal color=Unknown misc=1
			as=$(echo $line | cut -d '=' -f 2 | cut -d ' ' -f 1)
			device=$(echo $line | cut -d '=' -f 4 | cut -d ' ' -f 1)
			conn=$(echo $line | cut -d '=' -f 5 | cut -d ' ' -f 1)
			ctype=$(echo $line | cut -d '=' -f 6 | cut -d ' ' -f 1)
			loc=$(echo $line | cut -d '=' -f 7 | cut -d ' ' -f 1)
			# nid and association numbers are per codec: key them by hdaa id
			ag="${hdaa_id}_${as}"
			if ! echo "${as_group_list}" | grep -wq ${ag}; then
				as_group_list="${as_group_list} $ag"
			fi
			nid_desc="${device},${conn},${ctype},${loc}"
			eval "
				as_group_${ag}=\"\${as_group_${ag}:-} \${i}\"
				nid_${hdaa_id}_${i}_desc=\${nid_desc}
			"
			# Direction as the driver set the pin ("Pin control: 0x40 OUT",
			# "0x25 IN VREFs"), else from the default device
			pinctl=$(sysctl -n dev.hdaa.${hdaa_id}.nid${i} | sed -n 's/^ *Pin control: 0x[0-9a-f]* //p')
			case " ${pinctl} " in
			*" OUT "*) dir=out ;;
			*" IN "*) dir=in ;;
			*)
				case "${device}" in
				Line-out|Speaker|Headphones|SPDIF-out|Digital-out) dir=out ;;
				*) dir=in ;;
				esac
				;;
			esac
			if [ ${dir} = out ]; then
				add_edge "pcm${pcmid} play" "${pcm_desc}" "hdaa${hdaa_id}:nid${i}" "${nid_desc}"
			else
				add_edge "hdaa${hdaa_id}:nid${i}" "${nid_desc}" "pcm${pcmid} rec" "${pcm_desc}"
			fi
		done
	else
		pcm_location=$(sysctl -n dev.pcm.${pcmid}.%location)
		case "${pcm_location}" in
		*dbsf=*)
			# pcm attached directly to a PCI bus (e.g. AMD ACP): the bus
			# description is useless, show the PCI function instead
			parent_node=${pcm_location##*dbsf=}
			parent_node=${parent_node%% *}
			parent_desc=$(pciconf -lv ${parent_node} | sed -n "s/^ *device *= '\(.*\)'$/\1/p")
			;;
		*)
			parent_node=$(sysctl -n dev.pcm.${pcmid}.%parent)
			parent=$(echo ${parent_node} | tr -dc 'a-z')
			parent_id=$(echo ${parent_node} | tr -dc '0-9')
			parent_desc=$(sysctl -n dev.${parent}.${parent_id}.%desc | cut -d ',' -f 1)
			;;
		esac
		case "${pcm_dir}" in *play*)
			add_edge "pcm${pcmid} play" "${pcm_desc}" "${parent_node}" "${parent_desc}" ;;
		esac
		case "${pcm_dir}" in *rec*)
			add_edge "${parent_node}" "${parent_desc}" "pcm${pcmid} rec" "${pcm_desc}" ;;
		esac
	fi
done

# Smart speaker amplifiers behind the codec speaker pin (cs35l54(4)): they
# serve the codec whose subsystem id matches their ACPI _SUB
for ampid in $(sysctl -N dev.cs35l54 2>/dev/null | grep %desc | cut -d '.' -f 3); do
	sub=$(sysctl -n dev.cs35l54.${ampid}.subsystem 2>/dev/null) || continue
	amp_desc="$(sysctl -n dev.cs35l54.${ampid}.%desc), $(sysctl -n dev.cs35l54.${ampid}.%parent) $(sysctl -n dev.cs35l54.${ampid}.%location | sed 's/^addr=\([^ ]*\).*/\1/')"
	for ag in ${as_group_list}; do
		hdaa_id=${ag%%_*}
		sysctl -n dev.hdaa.${hdaa_id}.%pnpinfo | grep -qw "subsystem=0x${sub}" || continue
		eval "as_group=\${as_group_${ag}}"
		for i in ${as_group}; do
			eval "nid_desc=\${nid_${hdaa_id}_${i}_desc}"
			case "${nid_desc}" in
			Speaker,Fixed,*)
				add_edge "hdaa${hdaa_id}:nid${i}" "${nid_desc}" "cs35l54.${ampid}" "${amp_desc}"
				;;
			esac
		done
	done
done

# Print the nodes of the codec clusters, $1 = format, $2 = indentation
print_clusters() {
	for hdaa_id in ${hdaa_list}; do
		hdaa_desc=$(sysctl -n dev.hdaa.${hdaa_id}.%desc)
		if [ $1 = dot ]; then
			printf '%ssubgraph cluster_hdaa%s {\n' "$2" ${hdaa_id}
			printf '%s  label = "hdaa%s <%s>";\n' "$2" ${hdaa_id} "${hdaa_desc}"
		else
			printf '%ssubgraph hdaa%s ["hdaa%s<br/>%s"]\n' "$2" ${hdaa_id} ${hdaa_id} "${hdaa_desc}"
		fi
		for ag in ${as_group_list}; do
			[ ${ag%%_*} = ${hdaa_id} ] || continue
			as=${ag#*_}
			if [ $1 = dot ]; then
				printf '%s  subgraph cluster_%s {\n' "$2" $ag
				printf '%s    label = "association group %s";\n' "$2" $as
			else
				printf '%s  subgraph as_%s ["association group %s"]\n' "$2" $ag $as
			fi
			eval "as_group=\${as_group_${ag}}"
			for i in ${as_group}; do
				eval "nid_desc=\${nid_${hdaa_id}_${i}_desc}"
				if [ $1 = dot ]; then
					printf '%s    "hdaa%s:nid%s <%s>";\n' "$2" ${hdaa_id} ${i} "${nid_desc}"
				else
					printf '%s    %s\n' "$2" "$(mermaid_node "hdaa${hdaa_id}:nid${i}" "${nid_desc}")"
				fi
			done
			[ $1 = dot ] && printf '%s  }\n' "$2" || printf '%s  end\n' "$2"
		done
		[ $1 = dot ] && printf '%s}\n' "$2" || printf '%send\n' "$2"
	done
}

# dot rank line for the pcm nodes, $1 = rank, $2 = play or rec, $3 = pcm ids
dot_rank() {
	[ -n "$3" ] || return 0
	rank=""
	for pcmid in $3; do
		eval "pcm_desc=\${pcm_${pcmid}_desc}"
		rank="${rank} \"pcm${pcmid} $2 <${pcm_desc}>\";"
	done
	printf '  { rank = %s;%s }\n' "$1" "${rank}"
}

print_dot() {
	printf "digraph G {\n  rankdir = LR;\n"
	print_clusters dot "  "
	printf '%s' "${edges}" | while IFS='|' read -r from from_desc to to_desc; do
		printf '  "%s" -> "%s";\n' "$(dot_label "${from}" "${from_desc}")" \
		    "$(dot_label "${to}" "${to_desc}")"
	done
	# Playback pcm on the left, recording pcm on the right
	dot_rank min play "${play_pcms}"
	dot_rank max rec "${rec_pcms}"
	printf "}\n"
}

print_mermaid() {
	printf '```mermaid\nflowchart LR\n'
	# Subgraphs first: a node belongs to the subgraph it is declared in
	print_clusters mermaid "  "
	printf '%s' "${edges}" | while IFS='|' read -r from from_desc to to_desc; do
		printf '  %s --> %s\n' "$(mermaid_node "${from}" "${from_desc}")" \
		    "$(mermaid_node "${to}" "${to_desc}")"
	done
	printf '```\n'
}

print_${format}
